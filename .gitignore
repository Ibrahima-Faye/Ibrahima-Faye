# build output
dist/

# generated types & caches
.astro/
.vercel/
.netlify/
.wrangler/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# environment variables (garder .env.example)
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db
Desktop.ini

# editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Claude Code : réglages locaux uniquement
.claude/settings.local.json

# Corbeille de l'administration locale (suppressions récupérables)
.trash/

# Sauvegardes instantanées (npm run sauvegarde) : à copier ailleurs, jamais dans git
/backups/

# Originaux haute résolution : conservés sur cette machine, sauvegarde séparée (jamais dans git)
/media/

# Secrets de l'administration (mot de passe haché, sessions)
/.cms/

# ORIGINAUX des projets : conservés sur cette machine (sauvegarde séparée), jamais dans git.
# Le site publié n'utilise que leurs versions web (<projet>/_web/ + media.json, générées par `npm run medias`),
# qui, elles, SONT versionnées (voir les exceptions « ! » plus bas).
src/content/projects/**/*.jpg
src/content/projects/**/*.jpeg
src/content/projects/**/*.png
src/content/projects/**/*.webp
src/content/projects/**/*.avif
src/content/projects/**/*.gif
src/content/projects/**/*.heic
src/content/projects/**/*.heif
src/content/projects/**/*.mp4
src/content/projects/**/*.webm
src/content/projects/**/*.mov
src/content/projects/**/*.m4v
src/content/projects/**/*.svg

# Versions web (pipeline médias) : versionnées. Dossiers temporaires de génération : non.
!src/content/projects/*/_web/**
src/content/projects/*/_web/.tmp-*/
src/content/projects/*/_web/.lock
# Versions web de plus de 25 Mio (grosses vidéos) : JAMAIS dans git, prévues pour un stockage
# externe (Cloudflare R2…). Copie locale conservée ici ; voir docs/MEDIAS.md.
src/content/projects/*/_web/*/distant/

# Cloudflare (Wrangler) : état local et secrets locaux — jamais dans Git
.wrangler/
.dev.vars*
!.dev.vars.example
