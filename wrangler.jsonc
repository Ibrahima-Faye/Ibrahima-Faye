{
  // Worker Cloudflare du portfolio (déploiement : Workers Builds, « npx wrangler deploy » sur main).
  // Reprend EXACTEMENT la configuration que Wrangler générait automatiquement à chaque build
  // (autoconfig Astro), avec le vrai nom du Worker. Aucun secret ici : les secrets vont dans
  // les réglages du Worker (Cloudflare) ou dans .dev.vars en local (ignoré par Git).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ibrahima-faye",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["global_fetch_strictly_public"],
  // Entrée du Worker : zone /admin protégée (Cloudflare Access) ; tout le reste est servi comme avant.
  "main": "./src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /admin passe TOUJOURS par le Worker (vérification du jeton), jamais par un fichier statique.
    "run_worker_first": ["/admin", "/admin/*"],
  },
  // Secrets attendus (valeurs dans Cloudflare → Worker → Settings → Variables and Secrets, jamais ici) :
  // CF_ACCESS_TEAM_DOMAIN, CF_ACCESS_AUD, CMS_ALLOWED_EMAILS — voir .dev.vars.example.
  "observability": {
    "enabled": true,
  },
}
