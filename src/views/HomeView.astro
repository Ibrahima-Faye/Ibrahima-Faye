---
import { domainSlugs } from '@/data/domains';
import { useTranslations, type Locale } from '@/i18n';
import { site } from '@/config/site';
import { countBy, getFeaturedProjects, getProjects } from '@/lib/projects';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import Marquee from '@/components/sections/Marquee.astro';
import Manifesto from '@/components/sections/Manifesto.astro';
import Expertises from '@/components/sections/Expertises.astro';
import FeaturedProjects from '@/components/sections/FeaturedProjects.astro';
import Ecosystem from '@/components/sections/Ecosystem.astro';
import About from '@/components/sections/About.astro';
import Contact from '@/components/sections/Contact.astro';
import { settings } from '@/lib/settings';
import { sectionOrder, sectionProps, type SectionKey } from '@/lib/studio/layout';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const [projects, featured] = await Promise.all([getProjects(), getFeaturedProjects(6)]);
const counts = countBy(projects);

// Sections : ordre et visibilité réglables (src/settings/layout.json) ; sans réglage, l'ordre d'origine.
const layout = settings.layout;
const order = sectionOrder(layout).filter((key) => layout.sections?.[key]?.visible !== false);
const COMPONENTS = {
  hero: Hero,
  marquee: Marquee,
  manifesto: Manifesto,
  expertises: Expertises,
  projects: FeaturedProjects,
  ecosystem: Ecosystem,
  about: About,
  contact: Contact,
} satisfies Record<SectionKey, unknown>;
const extra: Partial<Record<SectionKey, Record<string, unknown>>> = {
  expertises: { counts: counts.domainCount },
  projects: { projects: featured },
  ecosystem: { counts: counts.entityCount },
};

const origin = new URL('/', Astro.site).href;
const personId = `${origin}#person`;

// Données structurées : la personne, ses deux entités, le site.
const jsonLd = {
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: site.name,
      jobTitle: t.meta.jobTitle,
      url: origin,
      description: t.meta.description,
      knowsAbout: domainSlugs.map((slug) => t.domains[slug].title),
      ...(site.socials.length ? { sameAs: site.socials.map((s) => s.href) } : {}),
    },
    ...(['clicgraph', 'jeefsys'] as const).map((slug) => ({
      '@type': 'Organization',
      name: t.entities[slug].name,
      description: t.entities[slug].description,
      founder: { '@id': personId },
    })),
    {
      '@type': 'WebSite',
      name: site.name,
      url: origin,
      inLanguage: t.meta.lang,
      author: { '@id': personId },
    },
  ],
};
---

<BaseLayout page="home" locale={locale} path="/" jsonLd={jsonLd}>
  {order.map((key) => {
    const Section = COMPONENTS[key] as any;
    return <Section locale={locale} section={sectionProps(layout, key)} {...extra[key]} />;
  })}
</BaseLayout>
