---

<svg
  class={className}
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={glyphs[slug]}
/>
