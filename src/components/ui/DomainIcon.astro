  'design-graphique':
    '<path d="M8 39C10 11 38 37 40 9"/><rect x="4.5" y="35.5" width="7" height="7"/><rect x="36.5" y="5.5" width="7" height="7"/><path d="M8 39 18 25M40 9 30 23" stroke-dasharray="2 3"/>',
  'impression-3d-fabrication':
    '<path d="M24 7 42 16 24 25 6 16z"/><path d="m6 23 18 9 18-9M6 30l18 9 18-9"/>',
  robotique:
    '<path d="M8 42h18M17 42V33"/><circle cx="17" cy="30" r="3"/><path d="M19 28 28 17"/><circle cx="29.500" cy="15" r="3"/><path d="m32 16 6 4M38 20l-1 8M38 20l6 5"/>',
  automatisation:
    '<path d="M39 20A16 16 0 0 0 9 16"/><path d="M9 8v8h8"/><path d="M9 28a16 16 0 0 0 30 4"/><path d="M39 40v-8h-8"/><circle cx="24" cy="24" r="3"/>',
  'electronique-electrotechnique':
    '<rect x="13" y="13" width="22" height="22" rx="2"/><rect x="19" y="19" width="10" height="10"/><path d="M19 13V5M29 13V5M19 43v-8M29 43v-8M13 19H5M13 29H5M43 19h-8M43 29h-8"/>',
  'informatique-industrielle':
    '<rect x="6" y="9" width="36" height="22" rx="2"/><path d="M15 9v22M24 9v22M33 9v22"/><circle cx="19.500" cy="15" r="1.200"/><circle cx="28.500" cy="15" r="1.200"/><circle cx="37.500" cy="15" r="1.200"/><path d="M24 31v6M10 37h28M10 37v5M24 37v5M38 37v5"/>',
  prototypage:
    '<path d="M24 5 41 14.500v19L24 43 7 33.500v-19z" stroke-dasharray="3 3"/><path d="m24 15 8.500 5v9L24 34l-8.500-5v-9z"/><path d="M24 15V5M32.500 20 41 14.500M32.500 29 41 33.500M24 34v9M15.500 29 7 33.500M15.500 20 7 14.500" stroke-dasharray="1 3"/>',
