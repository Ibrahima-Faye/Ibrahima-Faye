---
import { Picture } from 'astro:assets';
import type { DomainSlug } from '@/data/domains';
import type { DomainMedia } from '@/lib/media';
import DomainVisual from './DomainVisual.astro';

/**
 * Cadre d'un domaine : affiche le VRAI média s'il existe
 * (src/assets/domaines/<slug>.jpg | .mp4 …), sinon l'illustration technique.
 * Le média garde son ratio : il est contenu (object-fit: contain) sur un fond flouté
 * de lui-même — jamais recadré.
 */
interface Props {
  slug: DomainSlug;
  title: string;
  media: DomainMedia;
  /** Étiquette affichée quand il s'agit d'une illustration (pas d'un vrai média). */
  illustrationLabel: string;
  class?: string;
}

const { slug, title, media, illustrationLabel, class: className } = Astro.props;
const hasMedia = Boolean(media.image || media.video);
---

<figure class:list={['dframe', className]} data-domain-key={slug} data-active="false">
  <div class="dframe-grid" aria-hidden="true"></div>
  {media.video ? (
    <video
      class="dframe-media"
      src={media.video}
      muted
      loop
      playsinline
      preload="metadata"
      aria-label={title}
      data-domain-video
    />
  ) : media.image ? (
    <>
      <Picture
        src={media.image}
        alt=""
        formats={['webp']}
        widths={[240]}
        sizes="200px"
        pictureAttributes={{ class: 'dframe-backdrop' }}
        class="size-full object-cover"
        aria-hidden="true"
      />
      <Picture
        src={media.image}
        alt={title}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280]}
        sizes="(min-width: 1280px) 45vw, 92vw"
        loading="lazy"
        pictureAttributes={{ class: 'dframe-media-wrap' }}
        class="dframe-media"
      />
    </>
  ) : (
    <DomainVisual slug={slug} class="dframe-art" />
  )}
  <!-- coins « plan technique » -->
  <span class="dframe-corner tl" aria-hidden="true"></span>
  <span class="dframe-corner tr" aria-hidden="true"></span>
  <span class="dframe-corner bl" aria-hidden="true"></span>
  <span class="dframe-corner br" aria-hidden="true"></span>
  {!hasMedia && <figcaption class="dframe-tag">{illustrationLabel}</figcaption>}
</figure>

<style>
  .dframe {
    position: relative;
    isolation: isolate;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 0.5rem;
    border: 1px solid rgb(200 169 255 / 0.18);
    background:
      radial-gradient(90% 70% at 70% 15%, rgb(27 38 112 / 0.85), transparent 70%),
      var(--color-ink-900);
    box-shadow: 0 30px 90px -40px rgb(123 77 255 / 0.55);
  }

  .dframe-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(200 169 255 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(200 169 255 / 0.05) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(80% 80% at 50% 50%, #000 40%, transparent 100%);
  }

  .dframe :global(.dframe-art) {
    position: absolute;
    inset: 6% 8%;
    width: 84%;
    height: 88%;
  }

  .dframe :global(.dframe-backdrop) {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: block;
    opacity: 0.4;
    filter: blur(28px) saturate(1.4);
    transform: scale(1.2);
  }

  .dframe :global(.dframe-media-wrap) {
    position: absolute;
    inset: 0;
    display: block;
  }

  .dframe :global(.dframe-media),
  .dframe > video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .dframe-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 0 solid rgb(200 169 255 / 0.55);
  }
  .tl {
    top: 10px;
    left: 10px;
    border-width: 1px 0 0 1px;
  }
  .tr {
    top: 10px;
    right: 10px;
    border-width: 1px 1px 0 0;
  }
  .bl {
    bottom: 10px;
    left: 10px;
    border-width: 0 0 1px 1px;
  }
  .br {
    bottom: 10px;
    right: 10px;
    border-width: 0 1px 1px 0;
  }

  .dframe-tag {
    position: absolute;
    left: 16px;
    bottom: 14px;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(200 169 255 / 0.6);
  }
</style>
