---
import type { DomainSlug } from '@/data/domains';

/**
 * Illustration technique d'un domaine — SVG + CSS pur (aucun WebGL, aucune image).
 * Chaque dessin représente ce que le domaine fait réellement :
 *   3D & Architecture  → volumes isométriques, grille de sol, cotation
 *   Design graphique   → courbe de Bézier, ancres, poignées, nuancier
 *   Impression 3D      → pièce construite couche par couche, portique et buse
 *   Robotique          → bras articulé à 3 axes et pince
 *   Automatisation     → convoyeur, portique capteur, voyants d'état
 *   Électronique       → circuit imprimé, pistes, impulsions de courant
 *   Informatique ind.  → automate (alimentation, CPU, cartes d'E/S et voyants), réseau, schéma à contacts
 *   Prototypage        → itération v1 → v2 → v3 (croquis, fil de fer, volume)
 *
 * Les animations ne tournent QUE lorsque le visuel est actif
 * (attribut data-active="true", posé par src/scripts/expertises.ts).
 * `prefers-reduced-motion` : dessin fixe, aucune animation.
 */
interface Props {
  slug: DomainSlug;
  class?: string;
}

const { slug, class: className } = Astro.props;

/* ---------- géométrie isométrique ---------- */
type P = readonly [number, number];
const iso = (x: number, y: number, z: number, cx: number, cy: number, k: number): P => [
  +(cx + (x - y) * 0.866 * k).toFixed(1),
  +(cy + (x + y) * 0.5 * k - z * k).toFixed(1),
];
const pts = (list: P[]) => list.map((p) => p.join(',')).join(' ');
const line = (a: P, b: P) => `M${a.join(' ')}L${b.join(' ')}`;

/** Un volume : dessus + 2 faces visibles (+x et +y). */
function box(
  x0: number,
  x1: number,
  y0: number,
  y1: number,
  h: number,
  cx: number,
  cy: number,
  k: number,
) {
  const I = (x: number, y: number, z: number) => iso(x, y, z, cx, cy, k);
  return {
    top: pts([I(x0, y0, h), I(x1, y0, h), I(x1, y1, h), I(x0, y1, h)]),
    right: pts([I(x1, y0, 0), I(x1, y1, 0), I(x1, y1, h), I(x1, y0, h)]),
    left: pts([I(x0, y1, 0), I(x1, y1, 0), I(x1, y1, h), I(x0, y1, h)]),
  };
}

/* ---------- 3D & Architecture ---------- */
const A = { cx: 240, cy: 78, k: 30 };
const AI = (x: number, y: number, z: number) => iso(x, y, z, A.cx, A.cy, A.k);
const buildings = [
  { x0: 0.6, x1: 2.6, y0: 0.6, y1: 2.4, h: 2.2 },
  { x0: 3.2, x1: 5.4, y0: 0.6, y1: 2.2, h: 1.3 },
  { x0: 0.6, x1: 2.2, y0: 3.2, y1: 5.4, h: 3.1 },
  { x0: 3.2, x1: 4.8, y0: 3.2, y1: 4.8, h: 4.5 },
].map((b) => ({ ...b, ...box(b.x0, b.x1, b.y0, b.y1, b.h, A.cx, A.cy, A.k) }));
const floorLines = Array.from({ length: 7 }, (_, i) => [
  line(AI(i, 0, 0), AI(i, 6, 0)),
  line(AI(0, i, 0), AI(6, i, 0)),
]).flat();
const dimA = AI(-0.35, 5.4, 0);
const dimB = AI(-0.35, 5.4, 3.1);

/* ---------- Impression 3D ---------- */
const layers = Array.from({ length: 15 }, (_, i) => {
  const w = 96 + Math.round(70 * Math.sin((i / 14) * Math.PI * 0.92 + 0.15));
  return { i, w, y: 246 - i * 10 };
});

/* ---------- Électronique ---------- */
const traces: { d: string; pad: P }[] = [
  { d: '200,132 168,132 140,104 104,104', pad: [104, 104] },
  { d: '200,148 150,148 132,130 132,92', pad: [132, 92] },
  { d: '200,164 160,164 132,192 96,192', pad: [96, 192] },
  { d: '200,180 176,180 150,206 150,246', pad: [150, 246] },
  { d: '280,132 312,132 340,104 376,104', pad: [376, 104] },
  { d: '280,148 330,148 348,130 348,92', pad: [348, 92] },
  { d: '280,164 320,164 348,192 384,192', pad: [384, 192] },
  { d: '280,180 304,180 330,206 330,246', pad: [330, 246] },
];

/* ---------- Prototypage ---------- */
const cube = (cx: number, cy: number) => {
  const I = (x: number, y: number, z: number) => iso(x, y, z, cx, cy, 40);
  const b = box(0, 1, 0, 1, 1, cx, cy, 40);
  return {
    ...b,
    outline: pts([I(0, 0, 1), I(1, 0, 1), I(1, 0, 0), I(1, 1, 0), I(0, 1, 0), I(0, 1, 1)]),
    inner: `${line(I(1, 1, 1), I(0, 0, 1))}${line(I(1, 1, 1), I(1, 0, 0))}${line(I(1, 1, 1), I(0, 1, 0))}`,
  };
};
const cubes = [cube(110, 170), cube(240, 170), cube(370, 170)];
---

