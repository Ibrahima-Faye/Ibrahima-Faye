<style>
  .dv {
    display: block;
    width: 100%;
    height: 100%;
    color: var(--color-electric-400);
    overflow: visible;
  }

  /* — traits — */
  .l {
    fill: none;
    stroke: var(--color-mauve-300);
    stroke-opacity: 0.9;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .dim {
    stroke-opacity: 0.3;
  }
  .acc {
    stroke: var(--color-electric-400);
    stroke-opacity: 1;
  }
  .dash {
    stroke-dasharray: 3 6;
  }
  .face {
    fill: rgb(7 11 30 / 0.94);
  }
  .tint {
    fill: rgb(123 77 255 / 0.2);
  }
  .tint2 {
    fill: rgb(181 140 255 / 0.26);
  }
  .tint3 {
    fill: rgb(221 210 255 / 0.34);
  }
  .tube {
    stroke: var(--color-mauve-300);
  }
  .tube-in {
    stroke: rgb(7 11 30);
  }
  .tag text {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    fill: var(--color-mauve-300);
    fill-opacity: 0.75;
  }

  /* — états « dessiné » (visuel inactif, ou mouvement réduit) — */
  .draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .pulse {
    stroke-dasharray: 5 95;
    stroke-dashoffset: 100;
    stroke-width: 2.2;
  }
  .rise,
  .pop {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* ============ animations : uniquement quand le visuel est actif ============ */
  @media (prefers-reduced-motion: no-preference) {
    .dv[data-active='true'] .draw {
      animation: draw 1.5s cubic-bezier(0.65, 0, 0.35, 1) both;
      animation-delay: calc(var(--i, 0) * 70ms);
    }
    .dv[data-active='true'] .rise {
      animation: rise 0.9s var(--ease-out-expo) both;
      animation-delay: calc(var(--i, 0) * 90ms);
    }
    .dv[data-active='true'] .pop {
      animation: pop 0.6s var(--ease-out-expo) both;
      animation-delay: calc(var(--i, 0) * 60ms);
    }
    .dv[data-active='true'] .fade {
      animation: fade 0.8s ease both;
      animation-delay: calc(var(--i, 0) * 120ms);
    }

    /* 3D & Architecture : balayage de scan */
    .dv[data-active='true'] .scan {
      stroke-dasharray: 60 380;
      animation: scan 3.6s linear infinite;
    }

    /* Impression 3D : la pièce se construit, le portique monte avec elle */
    .dv[data-active='true'] .layer {
      transform-box: fill-box;
      transform-origin: center;
      animation: layer 0.45s var(--ease-out-expo) both;
      animation-delay: calc(var(--i) * 0.13s);
    }
    .dv[data-active='true'] .gantry {
      animation: gantry-up 2s linear both;
    }
    .dv[data-active='true'] .carriage {
      animation: sweep 1.6s ease-in-out infinite alternate;
    }

    /* Robotique : 3 axes + pince */
    .dv[data-active='true'] .arm1 {
      transform-box: view-box;
      transform-origin: 130px 240px;
      animation: swing1 4.2s ease-in-out infinite alternate;
    }
    .dv[data-active='true'] .arm2 {
      transform-box: view-box;
      transform-origin: 250px 130px;
      animation: swing2 3.1s ease-in-out infinite alternate;
    }
    .dv[data-active='true'] .f1 {
      transform-box: view-box;
      transform-origin: 372px 150px;
      animation: grip1 1.7s ease-in-out infinite alternate;
