---
/**
 * Visuel de remplacement quand un projet n'a pas encore d'image :
 * un « plan technique » abstrait, généré de façon déterministe à partir du slug
 * (le même projet a toujours le même visuel). Ce n'est PAS une image du projet.
 */
interface Props {
  seed: string;
  class?: string;
}

const { seed, class: className } = Astro.props;

function hash(input: string): number {
  let h = 2166136261;
  for (let i = 0; i < input.length; i++) {
    h ^= input.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

function rng(seedValue: number) {
  let a = seedValue;
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const id = `ph-${hash(seed).toString(36)}`;
const rand = rng(hash(seed));
const W = 800;
const H = 600;

const cx = 200 + rand() * 400;
const cy = 170 + rand() * 260;
const radii = [70, 120, 185, 260].map((r) => r * (0.8 + rand() * 0.5));
const rotation = Math.floor(rand() * 60) - 30;
const beamX = 80 + rand() * 640;
const marks = Array.from({ length: 5 }, () => ({ x: 40 + rand() * 720, y: 40 + rand() * 520 }));

// cube isométrique filaire
const s = 90 + rand() * 60;
const hexagon = [0, 1, 2, 3, 4, 5]
  .map((k) => {
    const a = (Math.PI / 3) * k - Math.PI / 6;
    return `${(cx + Math.cos(a) * s).toFixed(1)},${(cy + Math.sin(a) * s).toFixed(1)}`;
  })
  .join(' ');
---

<svg
  class={className}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={`${id}-bg`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#111a49"></stop>
      <stop offset="0.55" stop-color="#0b1233"></stop>
      <stop offset="1" stop-color="#070b1e"></stop>
    </linearGradient>
    <radialGradient id={`${id}-glow`} cx={cx / W} cy={cy / H} r="0.6">
      <stop offset="0" stop-color="#7b4dff" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#7b4dff" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id={`${id}-beam`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#c8a9ff" stop-opacity="0"></stop>
      <stop offset="0.5" stop-color="#c8a9ff" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#c8a9ff" stop-opacity="0"></stop>
    </linearGradient>
    <pattern id={`${id}-grid`} width="40" height="40" patternUnits="userSpaceOnUse">
      <path
        d="M40 0H0V40"
        fill="none"
        stroke="#c8a9ff"
        stroke-opacity="0.07"
        stroke-width="1"
      ></path>
    </pattern>
  </defs>

  <rect width={W} height={H} fill={`url(#${id}-bg)`}></rect>
  <rect width={W} height={H} fill={`url(#${id}-grid)`}></rect>
  <rect width={W} height={H} fill={`url(#${id}-glow)`}></rect>

  <g fill="none" stroke="#c8a9ff" stroke-linecap="round">
    {radii.map((r, i) => (
      <circle
        cx={cx}
        cy={cy}
        r={r}
        stroke-opacity={0.32 - i * 0.06}
        stroke-width="1"
        stroke-dasharray={i % 2 ? '2 7' : undefined}
      />
    ))}
    <g transform={`rotate(${rotation} ${cx} ${cy})`}>
      <polygon points={hexagon} stroke-opacity="0.7" stroke-width="1.25"></polygon>
      <path
        d={`M${cx} ${cy - s} V${cy} L${cx + s * 0.866} ${cy + s * 0.5} M${cx} ${cy} L${cx - s * 0.866} ${cy + s * 0.5}`}
        stroke-opacity="0.45"
      ></path>
    </g>
    <rect x={beamX - 0.5} y="0" width="1" height={H} fill={`url(#${id}-beam)`} stroke="none"></rect>
    {marks.map((m) => (
      <path
        d={`M${m.x - 6} ${m.y}H${m.x + 6}M${m.x} ${m.y - 6}V${m.y + 6}`}
        stroke-opacity="0.4"
      ></path>
    ))}
  </g>
</svg>
