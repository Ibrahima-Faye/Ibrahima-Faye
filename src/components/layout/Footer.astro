---
import { format, localizedPath, useTranslations, type Locale } from '@/i18n';
import { site } from '@/config/site';
import Icon from '@/components/ui/Icon.astro';
import { settings } from '@/lib/settings';
import { sectionStyle } from '@/lib/studio/layout';
import { inlineMarkdown, safeHref } from '@/lib/studio/content';
import LinkIcon from '@/components/ui/LinkIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const home = localizedPath('/', locale);
const year = new Date().getFullYear();

// Contenu du site → Footer : liens, description, réseaux (sinon : site d'origine)
const footer = settings.content.footer ?? {};
const customLinks = (footer.links ?? [])
  .map((l) => ({ label: l.label?.trim(), href: safeHref(l.href) }))
  .filter((l): l is { label: string; href: string } => Boolean(l.label && l.href));
const nav = customLinks.length
  ? customLinks
  : [
      { label: t.nav.expertises, href: `${home}#expertises` },
      { label: t.nav.projects, href: localizedPath('/projets/', locale) },
      { label: t.nav.ecosystem, href: `${home}#ecosysteme` },
      { label: t.nav.about, href: `${home}#a-propos` },
      { label: t.nav.contact, href: `${home}#contact` },
    ];
const socials = footer.socials === false ? [] : site.socials;
const universe = (['clicgraph', 'jeefsys'] as const).map((slug) => ({ slug, ...t.entities[slug] }));
// Studio → Sections → Pied de page : fond, effets, grand mot-symbole
const own = settings.layout.sections?.footer ?? {};
const look = sectionStyle(own);
---

<footer
  class="relative isolate overflow-hidden border-t border-white/[0.06] pt-24 pb-10"
  data-section="footer"
  style={look.style || undefined}
  {...look.attrs}
>
  <div
    data-section-deco
    class="from-navy-900/60 pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-2/3 bg-gradient-to-t to-transparent"
    aria-hidden="true"
  ></div>

  <div class="container-x">
    <div class="grid gap-14 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <p class="display-lg max-w-md">{site.name}</p>
        {footer.description?.trim() ? (
          <p class="text-paper-muted mt-4 max-w-sm" set:html={inlineMarkdown(footer.description)} />
        ) : (
          <p class="text-paper-muted mt-4 max-w-sm">{t.meta.jobTitle}</p>
        )}
        {socials.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2" aria-label={t.footer.socials}>
            {socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  class="link-line text-paper-muted hover:text-paper inline-flex items-center gap-2 text-sm"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {s.icon && <LinkIcon name={s.icon} class="size-4" />}
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div>
        <p class="eyebrow mb-5">{t.footer.explore}</p>
        <ul class="space-y-3">
          {nav.map((l) => (
            <li>
              <a
                href={l.href}
                class="link-line text-paper-muted hover:text-paper transition-colors"
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="eyebrow mb-5">{t.footer.universe}</p>
        <ul class="space-y-3">
          {universe.map((e) => (
            <li>
              <a
                href={`${localizedPath('/projets/', locale)}?entite=${e.slug}`}
                class="link-line text-paper-muted hover:text-paper transition-colors"
              >
                {e.name}
              </a>
              <span class="text-paper-faint ml-2 text-sm">— {e.role}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Grand mot-symbole -->
    {own.wordmark !== false && (
      <p
        data-anim="footer.wordmark"
        class="font-display text-outline mt-20 text-center text-[min(10.4vw,9.6rem)] leading-none font-extrabold tracking-tighter uppercase select-none"
        aria-hidden="true"
      >
        {site.name.split(' ')[0]}
      </p>
    )}

    <div class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-white/[0.06] pt-6">
      <p class="text-paper-faint text-sm">{format(t.footer.rights, { year })}</p>
      <a
        href="#top"
        class="link-line text-paper-muted hover:text-paper inline-flex items-center gap-2 text-sm"
        data-scroll-top
      >
        {t.footer.backToTop}
        <Icon name="arrow-up" class="size-4" />
      </a>
    </div>
  </div>
</footer>
