---
import { localizedPath, useTranslations, type Locale } from '@/i18n';
import { site } from '@/config/site';
import { settings } from '@/lib/settings';
import { navLinks, sectionAnchor, sectionVisible, type SectionKey } from '@/lib/studio/layout';
import { safeHref } from '@/lib/studio/content';
import LinkIcon from '@/components/ui/LinkIcon.astro';

interface Props {
  locale: Locale;
  /** Identifiant de la page courante (voir BaseLayout). */
  current?: string;
}

const { locale, current } = Astro.props;
const t = useTranslations(locale);
const home = localizedPath('/', locale);

/*
  Liens : réglables dans l'administration (Studio → Navigation, src/settings/navigation.json).
  `id` = ancre de la section visée sur la page d'accueil (défilement + section active : scripts/navigation.ts).
  Un lien vers une section masquée n'est pas affiché.
*/
const { layout, navigation, theme } = settings;
const nav = navLinks(navigation)
  .filter((l) => l.visible !== false)
  .map((l) => {
    const url = l.target.startsWith('url:') ? safeHref(l.target.slice(4)) : undefined;
    const page = l.target.startsWith('page:') ? l.target.slice(5) : '';
    const key = l.target as SectionKey;
    const external = Boolean(url);
    const hidden = !page && !external && !sectionVisible(layout, key);
    const anchor = page || external ? '' : sectionAnchor(layout, key);
    const label =
      l.label?.trim() || (l.labelKey ? t.nav[l.labelKey as keyof typeof t.nav] : '') || l.id;
    return {
      id: anchor || l.id,
      key: l.target,
      label,
      mobileLabel: l.mobileLabel?.trim() || label,
      href: url ?? (page ? localizedPath(page, locale) : `${home}#${anchor}`),
      external: Boolean(url && /^https?:/i.test(url)),
      button: l.button === true,
      hidden: hidden || (!page && !external && !anchor) || (l.target.startsWith('url:') && !url),
    };
  })
  .filter((l) => !l.hidden);
const links = nav.filter((l) => !l.button);
const buttons = nav.filter((l) => l.button);
const isProjectsPage = current === 'projects' || current === 'project';
/** « Projets » est actif sur la liste des projets et sur chaque page projet. */
const activeAttrs = (key: string) => ({
  'data-active': isProjectsPage && key === 'projects' ? 'true' : 'false',
  'aria-current': current === 'projects' && key === 'projects' ? ('page' as const) : undefined,
});
// Symbole (Contenu du site → Identité & Liens) : monogramme, photo ou logo.
// Sans choix : comportement d'origine (logo s'il existe, sinon monogramme).
const identity = theme.identity ?? {};
const mark =
  identity.mark === 'photo' && identity.photo
    ? 'photo'
    : identity.mark === 'monogram'
      ? 'monogram'
      : identity.logo && identity.mark !== 'photo'
        ? 'logo'
        : 'monogram';
const logo = identity.logo;
const photo = identity.photo;
const numbered = navigation.mobile?.numbered !== false;
/** Réseaux (Identité & Liens) : icônes en bas du menu mobile. */
const socials = site.socials;
---

<header
  data-header
  data-scrolled="false"
  data-scroll-behavior={navigation.scroll?.behavior}
  data-reading-line={navigation.scroll?.readingLine}
  data-nav-active={navigation.active?.enabled === false ? 'off' : undefined}
  class="group/header fixed inset-x-0 top-0 z-50 border-b border-transparent"
>
  <!--
    Fond flouté + filet sur un calque à part : un `backdrop-filter` posé sur <header> lui-même ferait du header
    le repère des éléments `fixed` qu'il contient, et le menu mobile plein écran serait réduit à 0 px de haut.
    (La bordure transparente du header garde sa hauteur ; le calque la recouvre exactement.)
  -->
  <div
    data-header-bg
    class="group-data-[scrolled=true]/header:bg-ink-950/75 pointer-events-none absolute inset-x-0 top-0 -bottom-px -z-10 border-b border-transparent transition-[background-color,border-color] duration-500 group-data-[scrolled=true]/header:border-white/[0.06] group-data-[scrolled=true]/header:backdrop-blur-xl"
    aria-hidden="true"
  ></div>
  <div class="container-x flex h-(--header-height) items-center justify-between gap-6">
    <a href={home} class="group flex items-center gap-3" aria-label={t.a11y.home}>
      {mark === 'logo' ? (
        <img src={logo} alt="" class="h-9 w-auto max-w-[9rem] object-contain" aria-hidden="true" />
      ) : mark === 'photo' ? (
        <img
          src={photo}
          alt=""
          class="border-mauve-300/40 group-hover:border-mauve-300 size-9 rounded-full border object-cover transition-colors duration-500"
          aria-hidden="true"
        />
      ) : (
        <span
          class="border-mauve-300/40 bg-navy-900/60 font-display text-lavender-100 group-hover:border-mauve-300 grid size-9 place-items-center rounded-full border text-[0.7rem] font-bold tracking-wider transition-colors duration-500"
          aria-hidden="true"
        >
          {site.initials}
        </span>
      )}
      <span class="font-display hidden text-[0.8rem] font-bold tracking-[0.22em] uppercase sm:block">
        {site.name}
      </span>
    </a>

    <nav
      class="hidden items-center md:flex"
      style="gap: var(--nav-gap, 2.25rem)"
      aria-label={t.a11y.mainNav}
    >
      {links.map((l) => (
        <a
          href={l.href}
          data-nav-link={l.id}
          {...activeAttrs(l.key)}
          target={l.external ? '_blank' : undefined}
          rel={l.external ? 'noopener noreferrer' : undefined}
          class="link-line text-paper-muted hover:text-paper data-[active=true]:text-paper py-1 text-[0.82rem] font-medium tracking-wide transition-colors"
        >
          {l.label}
        </a>
      ))}
      {buttons.map((l) => (
        <a
          href={l.href}
          class="btn btn-ghost !px-5 !py-2.5 !text-[0.8rem]"
          data-nav-link={l.id}
          target={l.external ? '_blank' : undefined}
          rel={l.external ? 'noopener noreferrer' : undefined}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <button
      type="button"
      class="border-mauve-300/30 relative grid size-11 place-items-center rounded-full border md:hidden"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={t.a11y.openMenu}
      data-label-open={t.a11y.openMenu}
      data-label-close={t.a11y.closeMenu}
    >
      <span class="relative block h-3 w-5" aria-hidden="true">
        <span class="bg-paper absolute top-0 left-0 h-px w-full transition-transform duration-500 [[aria-expanded=true]_&]:translate-y-[6px] [[aria-expanded=true]_&]:rotate-45"></span>
        <span class="bg-paper absolute bottom-0 left-0 h-px w-full transition-transform duration-500 [[aria-expanded=true]_&]:-translate-y-[5px] [[aria-expanded=true]_&]:-rotate-45"></span>
      </span>
    </button>
  </div>

  <!-- Menu mobile plein écran -->
  <div
    id="mobile-menu"
    data-menu-panel
    hidden
    class="bg-ink-950/95 fixed inset-0 top-(--header-height) z-40 overflow-y-auto backdrop-blur-2xl md:hidden"
  >
    <nav
      class="container-x flex min-h-full flex-col justify-center gap-2 py-10"
      aria-label={t.a11y.mainNav}
    >
      {[...links, ...buttons].map((l, i) => (
        <a
          href={l.href}
          data-menu-link
          data-nav-link={l.id}
          {...activeAttrs(l.key)}
          class="font-display data-[active=true]:text-mauve-300 border-b border-white/[0.07] py-4 text-4xl font-bold tracking-tight uppercase transition-colors"
        >
          {numbered && (
            <span class="eyebrow mr-4 align-middle">{String(i + 1).padStart(2, '0')}</span>
          )}
          {l.mobileLabel}
        </a>
      ))}
      {socials.length > 0 && (
        <ul class="mt-8 flex flex-wrap gap-3" aria-label={t.footer.socials}>
          {socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="border-mauve-300/30 text-lavender-100 hover:border-mauve-300 grid size-11 place-items-center rounded-full border transition-colors"
                aria-label={s.label}
              >
                <LinkIcon name={s.icon} class="size-5" />
              </a>
            </li>
          ))}
        </ul>
      )}
    </nav>
  </div>
</header>
