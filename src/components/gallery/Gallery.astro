---
/**
 * Galerie d'un projet.
 *  - Sans `blocks:` : la grille historique de 12 colonnes (balisage inchangé) ;
 *  - avec `blocks:` : chaque bloc dans l'ordre, puis les fichiers placés nulle part.
 * Toutes les tuiles partagent la même visionneuse (navigation dans toute la galerie).
 * Aucun recadrage : chaque média garde son ratio (voir GalleryItem.astro et src/styles/gallery-grid.css).
 */
import { type Locale } from '@/i18n';
import type { GalleryBlock, GalleryItem as Item } from '@/lib/media';
import GalleryItem from './GalleryItem.astro';
import Lightbox from './Lightbox.astro';
import '@/styles/gallery-grid.css';

interface Props {
  blocks: GalleryBlock[];
  locale?: Locale;
}

const { blocks, locale = 'fr' } = Astro.props;
const onlyLegacy = blocks.length === 1 && blocks[0]!.layout === 'legacy';

/** Les deux premiers médias de la page sont chargés tout de suite, les autres à l'approche. */
let position = 0;
const eager = () => position++ < 2;

/** Grille historique : largeur affichée ≈ span/12 de 92 % de l'écran. */
const legacySizes = (item: Item) =>
  `(min-width: 640px) ${Math.round((item.media.span / 12) * 92)}vw, 92vw`;

const legacyStyle = (item: Item) => `--span:${item.media.span};--align:${item.media.align}`;

/** Largeur disponible pour le bloc, selon son réglage `width`. */
const BLOCK_WIDTH = { content: 'min(56rem, 92vw)', wide: '92vw', full: '100vw' } as const;

const blockSizes = (block: GalleryBlock, item: Item) => {
  const base = BLOCK_WIDTH[block.width];
  const part = (span: number, cols: number) => `calc(${base} * ${(span / cols).toFixed(4)})`;
  return [
    `(min-width: 1024px) ${part(item.span.desktop, block.columns.desktop)}`,
    `(min-width: 640px) ${part(item.span.tablet, block.columns.tablet)}`,
    part(item.span.mobile, block.columns.mobile),
  ].join(', ');
};

const blockItemStyle = (item: Item) =>
  `--sd:${item.span.desktop};--st:${item.span.tablet};--sm:${item.span.mobile};--align:${item.align ?? 'var(--block-align, center)'}`;

const blockStyle = (block: GalleryBlock) =>
  `--cd:${block.columns.desktop};--ct:${block.columns.tablet};--cm:${block.columns.mobile}` +
  (block.align ? `;--block-align:${block.align}` : '');
---

{blocks.length > 0 && (
  <>
    {onlyLegacy ? (
      <div class="gg" data-gallery>
        {blocks[0]!.items.map((item) => (
          <GalleryItem
            media={item.media}
            placement="gg-item"
            style={legacyStyle(item)}
            sizes={legacySizes(item)}
            eager={eager()}
            locale={locale}
          />
        ))}
      </div>
    ) : (
      <div class="gb-stack" data-gallery>
        {blocks.map((block) => (
          <div class={`gb gb-${block.width}`} data-block={block.id} data-block-type={block.type}>
            {block.title && <h3 class="gb-title">{block.title}</h3>}
            {block.notice && import.meta.env.DEV && <p class="gb-notice">{block.notice}</p>}
            {block.layout === 'legacy' ? (
              <div class="gg">
                {block.items.map((item) => (
                  <GalleryItem
                    media={item.media}
                    placement="gg-item"
                    style={legacyStyle(item)}
                    sizes={legacySizes(item)}
                    eager={eager()}
                    locale={locale}
                  />
                ))}
              </div>
            ) : (
              <div class={`gb-grid gb-gap-${block.gap}`} style={blockStyle(block)}>
                {block.items.map((item) => (
                  <GalleryItem
                    media={item.media}
                    placement="gb-item"
                    style={blockItemStyle(item)}
                    sizes={blockSizes(block, item)}
                    eager={eager()}
                    locale={locale}
                  />
                ))}
              </div>
            )}
            {block.caption && <p class="gb-caption">{block.caption}</p>}
          </div>
        ))}
      </div>
    )}
    <Lightbox locale={locale} />
  </>
)}
