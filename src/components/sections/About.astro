---
/**
 * À propos — première section après le Hero : qui est Ibrahima Faye, avant les réalisations.
 * Textes : src/i18n/ui/fr.ts (about) — modifiables dans Contenu du site → À propos.
 * Fiche d'identité : tirée des données du site (domaines de chaque univers, entités), rien d'inventé.
 * Parcours / formation : affiché UNIQUEMENT s'il est renseigné dans l'administration.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { useTranslations, type Locale } from '@/i18n';
import { site } from '@/config/site';
import { settings } from '@/lib/settings';
import { inlineMarkdown, markdownBlocks, safeHref } from '@/lib/studio/content';
import { entityDomains } from '@/data/entities';
import Button from '@/components/ui/Button.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { SectionProps } from '@/lib/studio/layout';

interface Props {
  locale: Locale;
  /** Réglages de la section (Studio → Sections) : ancre, fond, hauteur, effets. */
  section?: SectionProps;
}

const { locale, section } = Astro.props;
const t = useTranslations(locale);

// Photo : déposer src/assets/portrait.jpg (ou .png / .webp / .avif) — détectée automatiquement.
const portraits = import.meta.glob<ImageMetadata>('/src/assets/portrait.{jpg,jpeg,png,webp,avif}', {
  eager: true,
  import: 'default',
});
const portrait = Object.values(portraits)[0];
// Photo de profil (Identité & Liens) : utilisée si aucun portrait n'est déposé dans src/assets/
const identity = settings.theme.identity ?? {};
const photo = portrait ? undefined : identity.photo;
const ratio = portrait ? portrait.width / portrait.height : 4 / 5;
// Contenu du site → À propos : blocs supplémentaires (titre, texte, liste, citation, image, bouton)
const blocks = settings.content.about?.blocks ?? [];
const timeline = (settings.content.about?.timeline ?? []).filter((item) => item.title?.trim());
const name = identity.name?.trim() || t.about.title;

// Fiche : création numérique (ClicGraph) · technologie (JeeFSYS) — domaines du site, sans doublon
const tech = entityDomains.jeefsys;
const creation = entityDomains.clicgraph.filter((d) => !tech.includes(d));
const facts = [
  { label: t.about.facts.profile, value: t.about.role },
  {
    label: t.about.facts.creation,
    value: creation.map((d) => t.domains[d].title).join(' · '),
  },
  { label: t.about.facts.technology, value: tech.map((d) => t.domains[d].title).join(' · ') },
  {
    label: t.about.facts.universe,
    value: `${t.entities.clicgraph.name} · ${t.entities.jeefsys.name}`,
  },
].filter((f) => f.value);
---

<section
  id={section?.id ?? 'a-propos'}
  data-section="about"
  data-anim="about.section"
  style={section?.style}
  {...section?.attrs}
  class="section-pad about relative isolate overflow-hidden"
  aria-labelledby="a-propos-title"
>
  <div
    data-section-deco
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"
    aria-hidden="true"
  ></div>

  <div class="container-x">
    <div
      class="grid items-start gap-14 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-24"
      data-parallax-scope
    >
      <!-- Portrait — ratio d'origine conservé, jamais recadré -->
      <div class="relative mx-auto w-full max-w-sm sm:max-w-md lg:sticky lg:top-28 lg:mx-0">
        <div
          class="about-halo bg-electric-600/20 pointer-events-none absolute -inset-10 -z-10 rounded-full blur-[90px]"
          data-parallax="0.2"
          data-section-deco
          aria-hidden="true"
        ></div>
        <div data-reveal="mask" data-anim="about.portrait">
          <div
            class="border-mauve-300/20 bg-navy-950 relative overflow-hidden rounded-[var(--radius-media,0.5rem)] border"
            style={`aspect-ratio:${ratio.toFixed(4)}`}
          >
            {portrait ? (
              <Picture
                src={portrait}
                alt={t.about.portraitAlt}
                formats={['avif', 'webp']}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1024px) 40vw, 90vw"
                pictureAttributes={{ class: 'block size-full' }}
                class="size-full object-cover"
              />
            ) : photo ? (
              <img
                src={photo}
                alt={t.about.portraitAlt}
                class="size-full object-cover"
                loading="lazy"
              />
            ) : (
              <div
                class="grid size-full place-items-center bg-[radial-gradient(80%_60%_at_50%_30%,var(--color-navy-800),var(--color-ink-950))]"
                role="img"
                aria-label={t.about.portraitAlt}
              >
                <span
                  class="font-display text-outline text-[clamp(6rem,16vw,11rem)] leading-none font-extrabold tracking-tighter"
                  aria-hidden="true"
                >
                  {site.initials}
                </span>
              </div>
            )}
            <div
              class="from-ink-950/60 pointer-events-none absolute inset-0 bg-gradient-to-t via-transparent to-transparent"
              aria-hidden="true"
            ></div>
            <p
              class="text-lavender-100 absolute bottom-4 left-4 font-mono text-[0.62rem] tracking-[0.22em] uppercase"
              aria-hidden="true"
            >
              {name}
            </p>
          </div>
          <!-- repères d'angle -->
          <span
            class="border-mauve-300/60 absolute -top-2 -left-2 size-5 border-t border-l"
            aria-hidden="true"
          ></span>
          <span
            class="border-mauve-300/60 absolute -right-2 -bottom-2 size-5 border-r border-b"
            aria-hidden="true"
          ></span>
        </div>
      </div>

      <div class="min-w-0">
        <SectionHeading
          headingId="a-propos-title"
          anim="about"
          index={section?.index}
          eyebrow={t.about.eyebrow}
          title={name}
        />
        <p
          class="text-mauve-300 mt-5 font-mono text-[0.72rem] tracking-[0.24em] uppercase"
          data-reveal="fade"
        >
          {t.about.role}
        </p>

        <div class="mt-10 space-y-6" data-anim="about.text">
          {t.about.paragraphs.map((paragraph, i) => (
            <p
              class:list={[
                'max-w-2xl leading-[1.7]',
                i === 0
                  ? 'text-lavender-100 font-display text-[clamp(1.3rem,1.1rem+0.9vw,1.85rem)] leading-[1.35] font-semibold tracking-[-0.01em]'
                  : 'text-paper-muted text-lg',
              ]}
              data-reveal
              set:html={inlineMarkdown(paragraph)}
            />
          ))}
        </div>

        <!-- Fiche d'identité : profil, les deux dimensions du travail, les univers -->
        <dl class="about-facts mt-12" data-reveal>
          {facts.map((fact) => (
            <div class="about-fact">
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>

        {blocks.length > 0 && (
          <div class="mt-12 space-y-6" data-anim="about.blocks">
            {blocks.map((block) => {
              if (block.type === 'heading' && block.text)
                return (
                  <h3 class="font-display text-2xl font-bold tracking-tight uppercase" data-reveal>
                    {block.text}
                  </h3>
                );
              if (block.type === 'text' && block.text)
                return (
                  <div
                    class="text-paper-muted max-w-2xl space-y-4 text-lg leading-[1.75]"
                    data-reveal
                  >
                    {markdownBlocks(block.text).map((b) =>
                      b.type === 'ul' ? (
                        <ul class="list-disc space-y-1 pl-5">
                          {b.html.map((li) => (
                            <li set:html={li} />
                          ))}
                        </ul>
                      ) : (
                        <p set:html={b.html[0]} />
                      ),
                    )}
                  </div>
                );
              if (block.type === 'list' && block.items?.length)
                return (
                  <ul class="border-t border-white/10" data-reveal>
                    {block.items.map((item) => (
                      <li
                        class="text-paper-muted border-b border-white/10 py-3"
                        set:html={inlineMarkdown(item)}
                      />
                    ))}
                  </ul>
                );
              if (block.type === 'quote' && block.text)
                return (
                  <blockquote
                    class="border-electric-500 text-lavender-200 max-w-2xl border-l-2 pl-5 text-xl italic"
                    data-reveal
                    set:html={inlineMarkdown(block.text)}
                  />
                );
              if (block.type === 'image' && block.src)
                return (
                  <img
                    src={block.src}
                    alt={block.alt ?? ''}
                    loading="lazy"
                    class="w-full max-w-2xl rounded-[var(--radius-media,0.5rem)]"
                    data-reveal
                  />
                );
              const href = safeHref(block.href);
              if (block.type === 'button' && block.label && href)
                return (
                  <div data-reveal>
                    <Button href={href} variant="ghost">
                      {block.label}
                    </Button>
                  </div>
                );
              return null;
            })}
          </div>
        )}

        <!-- Parcours / formation : seulement ce qui a été renseigné -->
        {timeline.length > 0 && (
          <div class="mt-14" data-reveal>
            <p class="eyebrow mb-6">{t.about.timelineLabel}</p>
            <ol class="about-timeline">
              {timeline.map((item) => (
                <li>
                  {item.period && <span class="about-period">{item.period}</span>}
                  <p class="font-display text-lg font-bold tracking-tight">{item.title}</p>
                  {item.text && (
                    <p
                      class="text-paper-muted mt-1.5 max-w-xl text-[0.95rem] leading-relaxed"
                      set:html={inlineMarkdown(item.text)}
                    />
                  )}
                </li>
              ))}
            </ol>
          </div>
        )}

        <!-- Approche : concevoir → visualiser → fabriquer → automatiser -->
        <div class="mt-16" data-reveal>
          <p class="eyebrow mb-7">{t.about.stepsLabel}</p>
          <ol class="about-steps">
            {t.about.steps.map((step, i) => (
              <li class="about-step">
                <span class="about-step-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="font-display block text-lg font-bold tracking-tight uppercase">
                  {step.title}
                </span>
                <span class="text-paper-muted mt-1.5 block text-[0.92rem] leading-relaxed">
                  {step.text}
                </span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* fiche d'identité : libellé mono à gauche, valeur à droite */
  .about-facts {
    border-top: 1px solid rgb(255 255 255 / 0.1);
  }

  .about-fact {
    display: grid;
    gap: 0.35rem;
    padding: 1rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }

  @media (min-width: 40rem) {
    .about-fact {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: 1.5rem;
      align-items: baseline;
    }
  }

  .about-fact dt {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-paper-faint);
  }

  .about-fact dd {
    color: var(--color-lavender-100);
    font-size: 1rem;
    line-height: 1.55;
  }

  /* parcours : ligne verticale et repères */
  .about-timeline {
    position: relative;
    display: grid;
    gap: 1.75rem;
    padding-left: 1.5rem;
    border-left: 1px solid rgb(200 169 255 / 0.25);
  }

  .about-timeline > li {
    position: relative;
  }

  .about-timeline > li::before {
    content: '';
    position: absolute;
    left: calc(-1.5rem - 4.5px);
    top: 0.45rem;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-mauve-300);
    box-shadow: 0 0 0 4px rgb(123 77 255 / 0.18);
  }

  .about-period {
    display: block;
    margin-bottom: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-mauve-300);
  }

  /* approche : quatre étapes reliées par un trait */
  .about-steps {
    display: grid;
    gap: 0;
    border-top: 1px solid rgb(255 255 255 / 0.1);
  }

  .about-step {
    position: relative;
    padding: 1.25rem 0 1.25rem 3.25rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }

  .about-step-num {
    position: absolute;
    left: 0;
    top: 1.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    color: var(--color-paper-faint);
    transition: color 0.4s;
  }

  .about-step:hover .about-step-num {
    color: var(--color-mauve-300);
  }

  @media (min-width: 48rem) {
    .about-steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
      border-top: 0;
    }

    .about-step {
      padding: 1.5rem 0 0;
      border-bottom: 0;
      border-top: 1px solid rgb(255 255 255 / 0.12);
    }

    /* le trait s'allume au survol */
    .about-step::before {
      content: '';
      position: absolute;
      top: -1px;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, var(--color-mauve-300), var(--color-electric-500));
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.7s var(--ease-out-expo);
    }

    .about-step:hover::before {
      transform: scaleX(1);
    }

    .about-step-num {
      position: static;
      display: block;
      margin-bottom: 0.9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-step::before {
      transition: none;
    }
  }
</style>
