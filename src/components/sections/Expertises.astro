---
/**
 * Expertises — ce que je sais réellement faire.
 * Liste des domaines + « scène » animée du domaine actif (illustrations : DomainVisual, pilotage :
 * scripts/expertises.ts), enrichies des outils du domaine et des projets qui le démontrent.
 * Puis les outils du CV, regroupés (Création & design / Technologies & ingénierie), avec leur niveau
 * s'il est réglé dans l'administration (jamais de valeur inventée).
 */
import { settings } from '@/lib/settings';
import { expertiseRows, inlineMarkdown } from '@/lib/studio/content';
import { localizedPath, plural, useTranslations, type Locale } from '@/i18n';
import { getDomainMedia } from '@/lib/media';
import DomainFrame from '@/components/ui/DomainFrame.astro';
import DomainIcon from '@/components/ui/DomainIcon.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ToolIcon from '@/components/ui/ToolIcon.astro';
import { domainSlugs, type DomainSlug } from '@/data/domains';
import { TOOL_ICONS } from '@/lib/tool-icons';
import { domainViews, toolGroups, toolViews, type ProjectRef, type ToolView } from '@/lib/tools';
import type { SectionProps } from '@/lib/studio/layout';

interface Props {
  locale: Locale;
  /** Nombre de projets par domaine (les domaines sans projet ne sont pas cliquables). */
  counts: Map<DomainSlug, number>;
  /** Projets publiés : relient chaque domaine et chaque outil aux réalisations. */
  projects?: ProjectRef[];
  /** Réglages de la section (Studio → Sections) : ancre, fond, hauteur, effets. */
  section?: SectionProps;
}

const { locale, counts, projects = [], section } = Astro.props;
const t = useTranslations(locale);
const projectsPath = localizedPath('/projets/', locale);

const tools = toolViews(projects, settings.content);
const groups = toolGroups(tools);
const titles = Object.fromEntries(domainSlugs.map((d) => [d, t.domains[d].title]));
const views = domainViews(projects, tools, titles);
/** Teinte d'un outil (couleur de sa marque) : lueur de la carte et de la barre de niveau. */
const toolTone = (tool: ToolView) => {
  const def = 'builtin' in tool.icon ? TOOL_ICONS[tool.icon.builtin] : undefined;
  return def && 'color' in def && def.color ? def.color : 'var(--color-mauve-300)';
};

// Contenu du site → Expertises : ordre, visibilité, texte complémentaire, icône (sinon : site d'origine)
const rows = expertiseRows(settings.content).map(({ slug, extra, icon }, i) => {
  const count = counts.get(slug) ?? 0;
  return {
    slug,
    number: String(i + 1).padStart(2, '0'),
    extra,
    icon,
    ...t.domains[slug],
    count,
    href: count > 0 ? `${projectsPath}?domaine=${slug}` : undefined,
    media: getDomainMedia(slug),
    tools: views.get(slug)?.tools ?? [],
    extras: views.get(slug)?.extras ?? [],
    projects: views.get(slug)?.projects ?? [],
  };
});
---

<section
  id={section?.id ?? 'expertises'}
  data-section="expertises"
  data-anim="expertises.section"
  style={section?.style}
  {...section?.attrs}
  class="section-pad relative"
  aria-labelledby="expertises-title"
>
  <div class="container-x">
    <SectionHeading
      headingId="expertises-title"
      anim="expertises"
      index={section?.index}
      eyebrow={t.expertises.eyebrow}
      title={t.expertises.title}
      intro={t.expertises.intro}
    />

    <div
      class="mt-16 grid gap-16 md:mt-24 xl:grid-cols-[minmax(0,1.12fr)_minmax(0,1fr)] xl:gap-20"
      data-expertises
    >
      <!-- Liste : chaque ligne active son visuel (survol, focus clavier, ou position au scroll) -->
      <ol class="border-t border-white/10" data-anim="expertises.items">
        {rows.map((row) => {
          const Tag = row.href ? 'a' : 'div';
          return (
            <li class="border-b border-white/10" data-reveal>
              <Tag
                href={row.href}
                tabindex={row.href ? undefined : 0}
                data-domain-key={row.slug}
                data-active="false"
                class="domain-row group relative grid grid-cols-[1fr_auto] items-center gap-x-5 gap-y-3 py-7 md:py-9 xl:grid-cols-[3.5rem_minmax(0,1fr)_auto] xl:gap-x-6"
              >
                <span class="num text-paper-faint col-start-1 row-start-1 font-mono text-sm tracking-widest transition-colors duration-500 xl:col-auto xl:row-auto">
                  {row.number}
                </span>
                <span class="col-span-2 row-start-2 min-w-0 xl:col-span-1 xl:row-auto">
                  <h3 class="title font-display text-[clamp(1.2rem,5.4vw,2.9rem)] leading-[1.05] font-bold tracking-[-0.025em] uppercase transition-transform duration-700 ease-[var(--ease-out-expo)] xl:text-[clamp(1.5rem,2.3vw,2.6rem)]">
                    {row.title}
                  </h3>
                  <p class="desc text-paper-muted mt-3 max-w-md text-[0.95rem] leading-relaxed">
                    {row.description}
                  </p>
                  {row.extra && (
                    <p
                      class="text-paper-faint mt-2 max-w-md text-[0.88rem] leading-relaxed"
                      set:html={inlineMarkdown(row.extra)}
                    />
                  )}
                  {row.tools.length > 0 && (
                    <span class="row-tools" aria-label={t.expertises.toolsEyebrow}>
                      {row.tools.map((tool, k) => (
                        <span class="row-tool" style={`--k:${k}`} title={tool.name}>
                          <ToolIcon icon={tool.icon} class="size-4" />
                          <span class="sr-only">{tool.name}</span>
                        </span>
                      ))}
                    </span>
                  )}
                </span>
                <span class="col-start-2 row-start-1 flex items-center justify-end gap-4 xl:col-auto xl:row-auto">
                  {row.count > 0 && (
                    <span class="text-paper-faint group-hover:text-lavender-100 hidden font-mono text-[0.68rem] tracking-widest whitespace-nowrap uppercase transition-colors sm:inline">
                      {plural(t.expertises.projectsCount, row.count)}
                    </span>
                  )}
                  <DomainIcon
                    slug={row.icon}
                    class="icon text-paper-faint size-9 shrink-0 transition-all duration-700 xl:size-11"
                  />
                </span>
              </Tag>
              {/* Visuel + outils + projets du domaine : petits écrans (la grande scène est à droite dès 1280 px) */}
              <div class="pb-8 xl:hidden" data-domain-key={row.slug} data-active="false">
                <DomainFrame
                  slug={row.slug}
                  title={row.title}
                  media={row.media}
                  illustrationLabel={t.expertises.illustration}
                  class="mx-auto max-w-xl"
                />
                <div class="proof mx-auto mt-5 max-w-xl">
                  {row.tools.length > 0 && (
                    <ul class="proof-tools">
                      {row.tools.map((tool) => (
                        <li class="proof-tool">
                          <ToolIcon icon={tool.icon} class="size-4" />
                          {tool.name}
                        </li>
                      ))}
                      {row.extras.map((name) => (
                        <li class="proof-tool is-extra">{name}</li>
                      ))}
                    </ul>
                  )}
                  {row.projects.length > 0 && (
                    <>
                      <p class="proof-label">{t.expertises.provenBy}</p>
                      <ul class="proof-projects">
                        {row.projects.map((p) => (
                          <li>
                            <a href={p.href} class="proof-project">
                              <span>{p.title}</span>
                              <Icon name="arrow-up-right" class="size-3.5 shrink-0" />
                            </a>
                          </li>
                        ))}
                      </ul>
                    </>
                  )}
                </div>
              </div>
            </li>
          );
        })}
      </ol>

      <!-- Scène : le visuel du domaine actif (grand écran) -->
      <div class="hidden xl:block" data-reveal>
        <div class="sticky top-28">
          <div class="stage grid">
            {rows.map((row) => (
              <div class="stage-item" data-domain-key={row.slug} data-active="false">
                <DomainFrame
                  slug={row.slug}
                  title={row.title}
                  media={row.media}
                  illustrationLabel={t.expertises.illustration}
                />
                <div class="mt-5 flex items-end justify-between gap-6">
                  <p class="font-display text-lavender-100 text-xl font-bold tracking-tight uppercase">
                    <span class="text-paper-faint mr-3 font-mono text-sm tracking-widest">
                      {row.number}
                    </span>
                    {row.title}
                  </p>
                  {row.href && (
                    <a
                      href={row.href}
                      class="link-line text-mauve-300 hover:text-lavender-100 inline-flex shrink-0 items-center gap-2 text-sm font-semibold"
                    >
                      {plural(t.expertises.projectsCount, row.count)}
                      <Icon name="arrow-right" class="size-4" />
                    </a>
                  )}
                </div>
                <div class="proof mt-5">
                  {row.tools.length > 0 && (
                    <ul class="proof-tools">
                      {row.tools.map((tool, k) => (
                        <li class="proof-tool" style={`--k:${k}`}>
                          <ToolIcon icon={tool.icon} class="size-4" />
                          {tool.name}
                        </li>
                      ))}
                      {row.extras.map((name, k) => (
                        <li class="proof-tool is-extra" style={`--k:${row.tools.length + k}`}>
                          {name}
                        </li>
                      ))}
                    </ul>
                  )}
                  <p class="proof-label">{t.expertises.provenBy}</p>
                  {row.projects.length > 0 ? (
                    <ul class="proof-projects">
                      {row.projects.map((p, k) => (
                        <li style={`--k:${k}`}>
                          <a href={p.href} class="proof-project">
                            <span>{p.title}</span>
                            <Icon name="arrow-up-right" class="size-3.5 shrink-0" />
                          </a>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="text-paper-faint mt-2 text-sm">{t.expertises.noProject}</p>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    {groups.length > 0 && (
      <div class="tools mt-28 md:mt-40" data-tools>
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div class="max-w-2xl">
            <p class="eyebrow flex items-center gap-4" data-reveal="fade">
              <span class="bg-mauve-400/50 h-px w-10" />
              <span>{t.expertises.toolsEyebrow}</span>
            </p>
            <h3
              class="font-display mt-5 text-[clamp(1.7rem,3.4vw,2.8rem)] leading-[1.05] font-bold tracking-[-0.025em]"
              data-split="lines"
            >
              {t.expertises.toolsTitle}
            </h3>
          </div>
          <p class="text-paper-muted max-w-md text-[0.98rem] leading-relaxed" data-reveal>
            {t.expertises.toolsIntro}
          </p>
        </div>

        <div class="tool-groups mt-14 md:mt-20">
          {groups.map((group, g) => (
            <section class="tool-group" aria-label={group.label} data-group={group.id}>
              <header class="tool-group-head" data-reveal>
                <span class="tool-group-num">{String(g + 1).padStart(2, '0')}</span>
                <h4 class="tool-group-title">{group.label}</h4>
                <span class="tool-group-rule" aria-hidden="true" />
              </header>
              {group.subgroups.map((sub) => (
                <div class="tool-sub">
                  {sub.label && (
                    <p class="tool-sub-label" data-reveal="fade">
                      {sub.label}
                    </p>
                  )}
                  <ul class="tool-grid">
                    {sub.tools.map((tool) => (
                      <li class="tool-card" data-reveal style={`--tone:${toolTone(tool)}`}>
                        <span class="tool-glow" aria-hidden="true" />
                        <div class="flex items-start gap-4">
                          <span class="tool-mark">
                            <ToolIcon icon={tool.icon} class="size-7" />
                          </span>
                          <div class="min-w-0 flex-1">
                            <p class="tool-name">{tool.name}</p>
                            <p class="tool-cat">{sub.label || group.label}</p>
                          </div>
                        </div>
                        {tool.usage && <p class="tool-usage">{tool.usage}</p>}
                        {tool.level && (
                          <div
                            class="lvl"
                            style={`--v:${tool.level.value}`}
                            data-level
                            role="img"
                            aria-label={`${t.expertises.levelLabel} : ${tool.level.label}`}
                          >
                            <div class="lvl-head">
                              <span>{t.expertises.levelLabel}</span>
                              <span class="lvl-value">{tool.level.label}</span>
                            </div>
                            <div class="lvl-track">
                              <span class="lvl-fill" />
                              <span class="lvl-ticks" aria-hidden="true" />
                            </div>
                          </div>
                        )}
                        {tool.projects.length > 0 && (
                          <p class="tool-used">
                            <span class="text-paper-faint">{t.expertises.usedIn} </span>
                            {tool.projects.map((p, i) => (
                              <>
                                {i > 0 && ', '}
                                <a href={p.href} class="link-line">
                                  {p.title}
                                </a>
                              </>
                            ))}
                          </p>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </section>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  /* Balayage violet au survol / à l'activation : ligne de lecture, sans carte ni bordure */
  .domain-row::before {
    content: '';
    position: absolute;
    inset: 0 calc(-1 * clamp(1.25rem, 4.5vw, 4rem));
    z-index: -1;
    background: linear-gradient(
      90deg,
      rgb(123 77 255 / 0.16),
      rgb(123 77 255 / 0.03) 60%,
      transparent
    );
    transform: scaleX(0);
    transform-origin: left;
    opacity: 0;
    transition:
      transform 0.8s var(--ease-out-expo),
      opacity 0.5s;
  }

  /* Repère vertical de la ligne active */
  .domain-row::after {
    content: '';
    position: absolute;
    left: calc(-1 * clamp(1.25rem, 4.5vw, 4rem) + 1px);
    top: 20%;
    bottom: 20%;
    width: 2px;
    background: linear-gradient(var(--color-mauve-300), var(--color-electric-500));
    transform: scaleY(0);
    transition: transform 0.6s var(--ease-out-expo);
  }

  .domain-row[data-active='true']::before,
  a.domain-row:hover::before,
  a.domain-row:focus-visible::before {
    transform: scaleX(1);
    opacity: 1;
  }

  .domain-row[data-active='true']::after {
    transform: scaleY(1);
  }

  .domain-row[data-active='true'] .num {
    color: var(--color-mauve-300);
  }

  .domain-row[data-active='true'] .title {
    color: var(--color-lavender-100);
  }

  .domain-row[data-active='true'] .desc {
    color: var(--color-lavender-200);
  }

  .domain-row[data-active='true'] .icon {
    color: var(--color-mauve-300);
    transform: scale(1.08) rotate(-4deg);
  }

  @media (min-width: 1280px) {
    .domain-row[data-active='true'] .title {
      transform: translateX(0.75rem);
    }
  }

  /* Scène : tous les visuels dans la même cellule, un seul visible */
  .stage > .stage-item {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transform: translateY(14px) scale(0.985);
    transition:
      opacity 0.6s var(--ease-out-expo),
      transform 0.8s var(--ease-out-expo),
      visibility 0s 0.6s;
  }

  .stage > .stage-item[data-active='true'] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  /* ------------------------------------------------------------------ logos des outils sur la ligne */
  .row-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 1rem;
  }

  .row-tool {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 0.5rem;
    background: rgb(4 5 13 / 0.5);
    opacity: 0.55;
    filter: grayscale(0.7);
    transition:
      opacity 0.5s var(--ease-out-expo),
      filter 0.5s,
      transform 0.6s var(--ease-out-expo),
      border-color 0.5s;
    transition-delay: calc(var(--k, 0) * 40ms);
  }

  .domain-row[data-active='true'] .row-tool,
  .domain-row:hover .row-tool {
    opacity: 1;
    filter: none;
    transform: translateY(-2px);
    border-color: rgb(200 169 255 / 0.25);
  }

  /* ------------------------------------------------------------------ outils + projets du domaine */
  .proof-tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .proof-tool {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid rgb(200 169 255 / 0.2);
    border-radius: 999px;
    background: rgb(7 11 30 / 0.6);
    color: var(--color-lavender-100);
    font-size: 0.78rem;
    line-height: 1.2;
  }

  .proof-tool.is-extra {
    border-color: rgb(255 255 255 / 0.09);
    color: var(--color-paper-muted);
  }

  .proof-label {
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-mauve-300);
  }

  .proof-projects {
    display: grid;
    gap: 0.1rem;
    margin-top: 0.5rem;
  }

  .proof-project {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.2rem 0;
    color: var(--color-paper);
    font-weight: 600;
    transition: color 0.3s;
  }

  .proof-project span {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.5s var(--ease-out-expo);
  }

  .proof-project:hover,
  .proof-project:focus-visible {
    color: var(--color-lavender-100);
  }

  .proof-project:hover span,
  .proof-project:focus-visible span {
    background-size: 100% 1px;
  }

  /* la scène active révèle ses outils puis ses projets en cascade */
  .stage-item .proof-tool,
  .stage-item .proof-projects li {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.5s var(--ease-out-expo),
      transform 0.7s var(--ease-out-expo);
  }

  .stage-item[data-active='true'] .proof-tool,
  .stage-item[data-active='true'] .proof-projects li {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.25s + var(--k, 0) * 55ms);
  }

  /* ------------------------------------------------------------------ outils du CV */
  .tool-groups {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(3.5rem, 7vw, 6rem);
  }

  .tool-group-head {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .tool-group-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: var(--color-mauve-300);
  }

  .tool-group-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .tool-group-rule {
    min-width: 2rem;
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgb(200 169 255 / 0.35), transparent);
  }

  .tool-sub {
    margin-top: 2rem;
  }

  .tool-sub-label {
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-paper-faint);
  }

  .tool-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16.5rem), 1fr));
  }

  .tool-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.25rem 1.25rem 1.35rem;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: var(--radius-card, 0.9rem);
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.03), transparent 45%), rgb(7 11 30 / 0.55);
    backdrop-filter: blur(10px);
    transition:
      border-color 0.5s var(--ease-out-expo),
      transform 0.6s var(--ease-out-expo);
  }

  /* lueur teintée de la couleur de l'outil, qui suit le survol */
  .tool-glow {
    position: absolute;
    inset: -40% -20% auto auto;
    z-index: -1;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--tone), transparent);
    opacity: 0.07;
    transition:
      opacity 0.6s var(--ease-out-expo),
      transform 0.8s var(--ease-out-expo);
  }

  .tool-card:hover,
  .tool-card:focus-within {
    border-color: color-mix(in oklab, var(--tone) 45%, transparent);
    transform: translateY(-4px);
  }

  .tool-card:hover .tool-glow,
  .tool-card:focus-within .tool-glow {
    opacity: 0.2;
    transform: translate(-12%, 18%) scale(1.15);
  }

  .tool-mark {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 0.85rem;
    background:
      radial-gradient(120% 120% at 20% 0%, rgb(255 255 255 / 0.07), transparent 60%),
      var(--color-navy-950);
    transition: transform 0.7s var(--ease-out-expo);
  }

  .tool-card:hover .tool-mark {
    transform: translateY(-2px) rotate(-5deg) scale(1.05);
  }

  .tool-name {
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .tool-cat {
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-mauve-300);
  }

  .tool-usage {
    margin-top: 0.9rem;
    color: var(--color-paper-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .tool-used {
    margin-top: 0.75rem;
    color: var(--color-paper-muted);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  /* petits écrans : deux colonnes compactes (20 outils restent lisibles sans défilement interminable) */
  @media (max-width: 39.99rem) {
    .tool-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.6rem;
    }

    .tool-card {
      padding: 0.9rem;
