---
/**
 * Expertises : les domaines pratiqués (compétence → projets qui la démontrent) puis les outils réellement
 * utilisés. Aucune jauge ni pourcentage : tout vient des fiches projet (catégorie, technologies) et de
 * l'administration (Contenu du site → Expertises : ordre, visibilité, texte, icône ; Outils).
 */
import { settings } from '@/lib/settings';
import { expertiseRows, inlineMarkdown } from '@/lib/studio/content';
import { localizedPath, plural, useTranslations, type Locale } from '@/i18n';
import { domainViews, toolViews, type ProjectRef } from '@/lib/tools';
import DomainIcon from '@/components/ui/DomainIcon.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ToolIcon from '@/components/ui/ToolIcon.astro';
import { domainSlugs, type DomainSlug } from '@/data/domains';
import type { SectionProps } from '@/lib/studio/layout';

interface Props {
  locale: Locale;
  /** Nombre de projets par domaine (les domaines sans projet ne sont pas cliquables). */
  counts: Map<DomainSlug, number>;
  /** Projets publiés : relient chaque domaine et chaque outil aux réalisations. */
  projects?: ProjectRef[];
  /** Réglages de la section (Studio → Sections) : ancre, fond, hauteur, effets. */
  section?: SectionProps;
}

const { locale, counts, projects = [], section } = Astro.props;
const t = useTranslations(locale);
const projectsPath = localizedPath('/projets/', locale);

const titles = Object.fromEntries(domainSlugs.map((d) => [d, t.domains[d].title]));
const views = domainViews(projects, titles);
const tools = toolViews(projects, settings.content);

// Contenu du site → Expertises : ordre, visibilité, texte complémentaire, icône (sinon : site d'origine)
const rows = expertiseRows(settings.content).map(({ slug, extra, icon }, i) => {
  const count = counts.get(slug) ?? 0;
  const view = views.get(slug)!;
  return {
    slug,
    number: String(i + 1).padStart(2, '0'),
    extra,
    icon,
    ...t.domains[slug],
    count,
    href: count > 0 ? `${projectsPath}?domaine=${slug}` : undefined,
    projects: view.projects,
    tools: view.tools.map((name) => tools.find((tool) => tool.name === name) ?? { name }),
    extras: view.extras,
  };
});
---

<section
  id={section?.id ?? 'expertises'}
  data-section="expertises"
  data-anim="expertises.section"
  style={section?.style}
  {...section?.attrs}
  class="section-pad relative"
  aria-labelledby="expertises-title"
>
  <div class="container-x">
    <SectionHeading
      headingId="expertises-title"
      anim="expertises"
      index={section?.index}
      eyebrow={t.expertises.eyebrow}
      title={t.expertises.title}
      intro={t.expertises.intro}
    />

    <!-- Domaines : chaque carte relie la compétence aux projets qui la démontrent -->
    <ol class="xp-grid mt-16 md:mt-24" data-anim="expertises.items">
      {rows.map((row) => (
        <li class="xp-card" data-reveal data-domain={row.slug}>
          <div class="xp-head">
            <span class="xp-num">{row.number}</span>
            <DomainIcon slug={row.icon} class="xp-icon size-10 shrink-0" />
          </div>
          <h3 class="xp-title">{row.title}</h3>
          <p class="xp-desc">{row.description}</p>
          {row.extra && <p class="xp-extra" set:html={inlineMarkdown(row.extra)} />}

          {(row.tools.length > 0 || row.extras.length > 0) && (
            <ul class="xp-tags" aria-label={t.expertises.toolsEyebrow}>
              {row.tools.map((tool) => (
                <li class="xp-tag is-tool">
                  {'icon' in tool && <ToolIcon icon={tool.icon} class="size-3.5" />}
                  {tool.name}
                </li>
              ))}
              {row.extras.map((name) => (
                <li class="xp-tag">{name}</li>
              ))}
            </ul>
          )}

          <div class="xp-proof">
            <p class="xp-label">{t.expertises.provenBy}</p>
            {row.projects.length > 0 ? (
              <ul class="xp-projects">
                {row.projects.map((p) => (
                  <li>
                    <a href={p.href} class="xp-project">
                      <span>{p.title}</span>
                      <Icon name="arrow-up-right" class="size-3.5 shrink-0" />
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="xp-empty">{t.expertises.noProject}</p>
            )}
            {row.href && row.count > 1 && (
              <a href={row.href} class="xp-all">
                {plural(t.expertises.projectsCount, row.count)}
                <Icon name="arrow-right" class="size-3.5" />
              </a>
            )}
          </div>
        </li>
      ))}
    </ol>

    {/* Outils réellement cités dans les fiches projet (ou ajoutés dans l'administration) */}
    {tools.length > 0 && (
      <div class="mt-24 md:mt-32">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div class="max-w-2xl">
            <p class="eyebrow flex items-center gap-4" data-reveal="fade">
              <span class="bg-mauve-400/50 h-px w-10" />
              <span>{t.expertises.toolsEyebrow}</span>
            </p>
            <h3
              class="font-display mt-5 text-[clamp(1.6rem,3vw,2.4rem)] leading-[1.08] font-bold tracking-[-0.02em]"
              data-reveal
            >
              {t.expertises.toolsTitle}
            </h3>
          </div>
          <p class="text-paper-muted max-w-md text-[0.95rem] leading-relaxed" data-reveal>
            {t.expertises.toolsIntro}
          </p>
        </div>

        <ul class="tool-grid mt-12">
          {tools.map((tool) => (
            <li class="tool-card" data-reveal>
              <span class="tool-mark">
                <ToolIcon icon={tool.icon} class="size-7" />
              </span>
              <div class="min-w-0">
                <p class="tool-name">{tool.name}</p>
                {tool.domains.length > 0 && (
                  <p class="tool-cat">{tool.domains.map((d) => t.domains[d].title).join(' · ')}</p>
                )}
                {tool.usage && <p class="tool-usage">{tool.usage}</p>}
                {tool.projects.length > 0 && (
                  <p class="tool-used">
                    <span class="text-paper-faint">{t.expertises.usedIn} </span>
                    {tool.projects.map((p, i) => (
                      <>
                        {i > 0 && ', '}
                        <a href={p.href} class="link-line">
                          {p.title}
                        </a>
                      </>
                    ))}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

<style>
  /* ------------------------------------------------------------------ domaines */
  .xp-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 48rem) {
    .xp-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }

    /* nombre impair de cartes : la dernière occupe toute la largeur */
    .xp-card:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 80rem) {
    .xp-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .xp-card:last-child:nth-child(odd) {
      grid-column: auto;
    }

    .xp-card:last-child:nth-child(3n + 1) {
      grid-column: 1 / -1;
    }
  }

  .xp-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(1.5rem, 2.4vw, 2rem);
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: var(--radius-card, 0.9rem);
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.025), transparent 40%), rgb(7 11 30 / 0.55);
    transition:
      border-color 0.5s var(--ease-out-expo),
      transform 0.6s var(--ease-out-expo),
      background-color 0.5s;
  }

  /* trait mauve supérieur, révélé au survol */
  .xp-card::before {
    content: '';
    position: absolute;
    inset: -1px -1px auto;
    height: 2px;
    border-radius: inherit;
    background: linear-gradient(
      90deg,
      var(--color-mauve-300),
      var(--color-electric-500),
      transparent
    );
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease-out-expo);
  }

  .xp-card:hover,
  .xp-card:focus-within {
    border-color: rgb(200 169 255 / 0.28);
    transform: translateY(-3px);
  }

  .xp-card:hover::before,
  .xp-card:focus-within::before {
    transform: scaleX(1);
  }

  .xp-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .xp-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: var(--color-paper-faint);
    transition: color 0.5s;
  }

  /* l'icône est rendue par un composant enfant : sélecteur global */
  .xp-card :global(.xp-icon) {
    color: var(--color-paper-faint);
    transition:
      color 0.5s,
      transform 0.7s var(--ease-out-expo);
  }

  .xp-card:hover .xp-num,
  .xp-card:focus-within .xp-num,
  .xp-card:hover :global(.xp-icon),
  .xp-card:focus-within :global(.xp-icon) {
    color: var(--color-mauve-300);
  }

  .xp-card:hover :global(.xp-icon),
  .xp-card:focus-within :global(.xp-icon) {
    transform: rotate(-6deg) scale(1.06);
  }

  .xp-title {
    margin-top: 1.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.65rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .xp-desc {
    margin-top: 0.85rem;
    max-width: 36rem;
    color: var(--color-paper-muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .xp-extra {
    margin-top: 0.5rem;
    color: var(--color-paper-faint);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .xp-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.25rem;
  }

  .xp-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid rgb(255 255 255 / 0.09);
    border-radius: 999px;
    color: var(--color-paper-muted);
    font-size: 0.74rem;
    line-height: 1.2;
  }

  .xp-tag.is-tool {
    border-color: rgb(200 169 255 / 0.25);
    color: var(--color-lavender-100);
  }

  .xp-proof {
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .xp-proof::before {
    content: '';
    display: block;
    height: 1px;
    margin-bottom: 1rem;
    background: linear-gradient(90deg, rgb(255 255 255 / 0.12), transparent);
  }

  .xp-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-mauve-300);
  }

  .xp-projects {
    display: grid;
    gap: 0.15rem;
    margin-top: 0.6rem;
  }

  .xp-project {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.2rem 0;
    color: var(--color-paper);
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.3s;
  }

  .xp-project span {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.5s var(--ease-out-expo);
  }

  .xp-project:hover,
  .xp-project:focus-visible {
    color: var(--color-lavender-100);
  }

  .xp-project:hover span,
  .xp-project:focus-visible span {
    background-size: 100% 1px;
  }

  .xp-empty {
    margin-top: 0.6rem;
    color: var(--color-paper-faint);
    font-size: 0.88rem;
  }

  .xp-all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    color: var(--color-mauve-300);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: color 0.3s;
  }

  .xp-all:hover {
    color: var(--color-lavender-100);
  }

  /* ------------------------------------------------------------------ outils */
  .tool-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }

  .tool-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    min-width: 0;
    padding: 1.25rem;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: var(--radius-card, 0.9rem);
    background: rgb(7 11 30 / 0.45);
    transition:
      border-color 0.5s var(--ease-out-expo),
      background-color 0.5s;
  }

  .tool-card:hover,
  .tool-card:focus-within {
    border-color: rgb(200 169 255 / 0.28);
    background: rgb(123 77 255 / 0.06);
  }

  .tool-mark {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid rgb(200 169 255 / 0.2);
    border-radius: 0.8rem;
    background:
      radial-gradient(120% 120% at 20% 0%, rgb(123 77 255 / 0.22), transparent 65%),
      var(--color-navy-950);
    color: var(--color-lavender-100);
    transition: transform 0.6s var(--ease-out-expo);
  }

  .tool-card:hover .tool-mark {
    transform: translateY(-2px) rotate(-4deg);
  }

  .tool-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .tool-cat {
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-mauve-300);
  }

  .tool-usage {
    margin-top: 0.55rem;
    color: var(--color-paper-muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .tool-used {
    margin-top: 0.5rem;
    color: var(--color-paper-muted);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .xp-card,
    .xp-card::before,
    .xp-card :global(.xp-icon),
    .tool-mark {
      transition: none;
    }

    .xp-card:hover,
    .xp-card:focus-within {
      transform: none;
    }
  }
</style>
