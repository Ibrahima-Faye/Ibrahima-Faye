---
import { entityDomains } from '@/data/entities';
import { isDomainSlug } from '@/data/domains';
import { settings } from '@/lib/settings';
import { entityItems, inlineMarkdown, safeHref } from '@/lib/studio/content';
import DomainIcon from '@/components/ui/DomainIcon.astro';
import { format, localizedPath, useTranslations, type Locale } from '@/i18n';
import type { EntitySlug } from '@/data/entities';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { site } from '@/config/site';
import { countBy, getProjects } from '@/lib/projects';
import type { SectionProps } from '@/lib/studio/layout';

interface Props {
  locale: Locale;
  /** Nombre de projets par entité (le lien « Voir les projets » n'apparaît que s'il y en a). */
  counts: Map<EntitySlug, number>;
  /** Réglages de la section (Studio → Sections) : ancre, fond, hauteur, effets. */
  section?: SectionProps;
}

const { locale, counts, section } = Astro.props;
const t = useTranslations(locale);
const projectsPath = localizedPath('/projets/', locale);
/*
  Domaines cliquables : même lien que la section Expertises, /projets/?domaine=<slug>, lu par le filtre
  de la page Projets (src/scripts/filters.ts). Ce filtre n'existe que pour les domaines qui ont des projets :
  un domaine sans projet reste une simple puce (jamais un lien vers une liste non filtrée).
*/
const domainCounts = countBy(await getProjects()).domainCount;

/*
  Contenu du site → Écosystème : entités éditables (ClicGraph, JeeFSYS, et celles ajoutées).
  Les textes de ClicGraph / JeeFSYS restent ceux du dictionnaire (partagés avec les cartes, filtres…).
*/
const entities = entityItems(settings.content).map((item, i) => {
  const builtin = item.builtin ? (item.id as 'clicgraph' | 'jeefsys') : null;
  const copy = builtin
    ? t.entities[builtin]
    : { name: item.name ?? '', role: item.role ?? '', description: item.description ?? '' };
  const domainList = item.domains ?? (builtin ? entityDomains[builtin] : []);
  const count = builtin ? (counts.get(builtin) ?? 0) : 0;
  const href =
    safeHref(item.href) ?? (builtin && count > 0 ? `${projectsPath}?entite=${builtin}` : undefined);
  return {
    slug: item.id,
    index: String(i + 1).padStart(2, '0'),
    ...copy,
    domains: domainList.filter(isDomainSlug).map((d) => ({
      title: t.domains[d].title,
      href: (domainCounts.get(d) ?? 0) > 0 ? `${projectsPath}?domaine=${d}` : undefined,
    })),
    href: item.button === false ? undefined : href,
    buttonLabel: item.buttonLabel?.trim() || format(t.ecosystem.seeProjects, { name: copy.name }),
    logo: item.logo,
    icon: item.icon && isDomainSlug(item.icon) ? item.icon : undefined,
    rich: !builtin,
  };
});

// Deux entités : composition « noyau + deux pôles » avec flux lumineux ; sinon, pôles en grille sous le noyau.
const composed = entities.length === 2;
/** Teinte de chaque pôle : ClicGraph (création) mauve, JeeFSYS (technologie) électrique, autres lavande. */
const tone = (slug: string) =>
  slug === 'clicgraph'
    ? 'var(--color-mauve-400)'
    : slug === 'jeefsys'
      ? 'var(--color-electric-400)'
      : 'var(--color-lavender-200)';
---

<section
  id={section?.id ?? 'ecosysteme'}
  data-section="ecosystem"
  data-anim="ecosystem.section"
  style={section?.style}
  {...section?.attrs}
  class="section-pad relative isolate overflow-hidden"
  aria-labelledby="ecosysteme-title"
>
  <div
    data-section-deco
    class="absolute inset-0 -z-10 bg-[radial-gradient(60%_45%_at_50%_62%,var(--color-navy-800)_0%,transparent_100%)] opacity-80"
    aria-hidden="true"
  ></div>

  <div class="container-x">
    <SectionHeading
      headingId="ecosysteme-title"
      anim="ecosystem"
      index="03"
      eyebrow={t.ecosystem.eyebrow}
      title={t.ecosystem.title}
      intro={t.ecosystem.intro}
    />

    <!--
      Écosystème : un noyau d'identité (Ibrahima Faye) d'où partent deux pôles.
      Animation d'entrée, parallaxe et lueur au survol : src/scripts/motion.ts (setupEcosystem).
    -->
    <div
      class:list={['eco', composed && 'is-composed']}
      data-connector
      data-anim="ecosystem.panels"
    >
      {composed && (
        <svg
          class="eco-links"
          viewBox="0 0 1000 560"
          preserveAspectRatio="none"
          aria-hidden="true"
          data-links
        >
          <defs>
            <linearGradient id="eco-flow-left" x1="1" y1="0" x2="0" y2="0">
              <stop offset="0" style="stop-color: var(--color-lavender-100); stop-opacity: 0.75" />
              <stop offset="1" style="stop-color: var(--color-mauve-400); stop-opacity: 0.4" />
            </linearGradient>
            <linearGradient id="eco-flow-right" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" style="stop-color: var(--color-lavender-100); stop-opacity: 0.75" />
              <stop offset="1" style="stop-color: var(--color-electric-400); stop-opacity: 0.4" />
            </linearGradient>
          </defs>
          {/* flux principaux (dessinés à l'apparition) et filaments secondaires, très discrets */}
          <g fill="none">
            <path
              class="eco-link"
              data-link
              pathLength="1"
              stroke="url(#eco-flow-left)"
              d="M500 280 C 440 280, 424 218, 358 224"
            />
            <path
              class="eco-link"
              data-link
              pathLength="1"
              stroke="url(#eco-flow-right)"
              d="M500 280 C 560 280, 576 342, 642 336"
            />
            <path
              class="eco-filament"
              data-link
              pathLength="1"
              stroke="url(#eco-flow-left)"
              d="M500 280 C 452 304, 420 352, 358 338"
            />
            <path
              class="eco-filament"
              data-link
              pathLength="1"
              stroke="url(#eco-flow-right)"
              d="M500 280 C 548 256, 580 208, 642 222"
            />
            <circle class="eco-terminal is-left" cx="358" cy="224" r="2.6" />
            <circle class="eco-terminal is-right" cx="642" cy="336" r="2.6" />
            <path
              class="eco-pulse"
              data-pulse
              pathLength="1"
              d="M500 280 C 440 280, 424 218, 358 224"
            />
            <path
              class="eco-pulse is-late"
              data-pulse
              pathLength="1"
              d="M500 280 C 560 280, 576 342, 642 336"
            />
          </g>
        </svg>
      )}

      {entities.map((e, i) => (
        <>
          {i === (composed ? 1 : 0) && (
            <div class="eco-core-slot" data-parallax-depth="-1">
              <div class="eco-core" data-core>
                <span class="eco-core-halo" data-core-halo aria-hidden="true" />
                <svg
                  class="eco-core-rings"
                  viewBox="0 0 200 200"
                  aria-hidden="true"
                  data-core-rings
                >
                  <circle class="eco-ring is-outer" cx="100" cy="100" r="96" />
                  <circle class="eco-ring is-dashed" cx="100" cy="100" r="82" />
                  <circle class="eco-ring is-inner" cx="100" cy="100" r="66" />
                  <circle class="eco-node" cx="4" cy="100" r="2.2" />
                  <circle class="eco-node" cx="196" cy="100" r="2.2" />
                  <circle class="eco-node is-faint" cx="100" cy="4" r="1.6" />
                  <circle class="eco-node is-faint" cx="100" cy="196" r="1.6" />
                </svg>
                <span class="eco-core-mark" data-core-mark>
                  <span class="eco-core-initials">{site.initials}</span>
                </span>
              </div>
              <p class="eco-core-name">{site.name}</p>
            </div>
          )}

          <div
            class="eco-slot"
            data-side={composed ? (i === 0 ? 'left' : 'right') : undefined}
            data-parallax-depth="1"
          >
            <article
              data-panel
              data-entity={e.slug}
              class="eco-pole"
              style={`--tone:${tone(e.slug)}`}
            >
              <div class="eco-pole-bg" aria-hidden="true">
                <span class="eco-pole-grid" />
                <span class="eco-pole-glow" />
              </div>

              <header class="eco-pole-head">
                <span class="eco-pole-index">{e.index}</span>
                <span class="eco-pole-rule" aria-hidden="true" />
                <span class="eco-pole-role">{e.role}</span>
              </header>

              {(e.logo || e.icon) && (
                <div class="mt-8 flex items-center gap-4">
                  {e.logo && (
                    <img src={e.logo} alt="" class="h-12 w-auto max-w-[10rem] object-contain" />
                  )}
                  {e.icon && <DomainIcon slug={e.icon} class="text-mauve-300 size-10" />}
                </div>
              )}

              <h3 class="eco-pole-name">{e.name}</h3>

              {e.rich ? (
                <p class="eco-pole-text" set:html={inlineMarkdown(e.description)} />
              ) : (
                <p class="eco-pole-text">{e.description}</p>
              )}

              {e.domains.length > 0 && (
                <>
                  <p class="eco-pole-label">{t.ecosystem.domainsLabel}</p>
                  <ul class="eco-domains">
                    {e.domains.map((d) =>
                      d.href ? (
                        <li class="eco-domain is-link">
                          <a
                            href={d.href}
                            class="eco-domain-hit"
                            aria-label={`${t.expertises.seeProjects} — ${d.title}`}
                          >
                            <span class="eco-domain-dot" aria-hidden="true" />
                            {d.title}
                          </a>
                        </li>
                      ) : (
                        <li class="eco-domain">
                          <span class="eco-domain-dot" aria-hidden="true" />
                          {d.title}
                        </li>
                      ),
                    )}
                  </ul>
                </>
              )}

              {e.href && (
                <a href={e.href} class="eco-pole-link">
                  <span>{e.buttonLabel}</span>
                  <Icon name="arrow-right" class="size-4" />
                </a>
              )}
            </article>
          </div>
        </>
      ))}
    </div>
  </div>
</section>

<style>
  /* ------------------------------------------------------------------ composition */
  .eco {
    position: relative;
    display: grid;
    gap: 1.5rem;
    margin-top: 4.5rem;
  }

  @media (min-width: 48rem) {
    .eco {
      margin-top: 6rem;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem;
    }

    .eco-core-slot {
      grid-column: 1 / -1;
    }
  }

  /* tablette et mobile : le noyau d'abord (point d'origine), puis les pôles */
  @media (max-width: 63.99rem) {
    .eco-core-slot {
      order: -1;
    }
  }

  @media (min-width: 48rem) and (max-width: 63.99rem) {
    .eco .eco-pole-name {
      font-size: clamp(1.9rem, 4.2vw, 2.6rem);
    }
  }

  /* ordinateur, deux entités : pôle — noyau — pôle */
  @media (min-width: 64rem) {
    .eco.is-composed {
      grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.78fr) minmax(0, 1fr);
      align-items: center;
      gap: 0;
    }

    .eco.is-composed .eco-core-slot {
      grid-column: auto;
      grid-row: 1;
      grid-column-start: 2;
    }

    .eco.is-composed .eco-slot[data-side='left'] {
      grid-column: 1;
      grid-row: 1;
      transform: translateY(-1.75rem);
    }

    .eco.is-composed .eco-slot[data-side='right'] {
      grid-column: 3;
      grid-row: 1;
      transform: translateY(1.75rem);
    }
  }

  /* ------------------------------------------------------------------ flux lumineux */
  .eco-links {
    display: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
  }

  @media (min-width: 64rem) {
    .eco-links {
      display: block;
    }
  }

  .eco-link {
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .eco-filament {
    stroke-width: 0.8;
    stroke-dasharray: 0.006 0.012;
    opacity: 0.6;
  }

  /* point de contact lumineux entre un flux et son pôle */
  .eco-terminal {
    fill: var(--color-lavender-100);
  }

  .eco-terminal.is-left {
    filter: drop-shadow(0 0 5px var(--color-mauve-400));
  }

  .eco-terminal.is-right {
    filter: drop-shadow(0 0 5px var(--color-electric-400));
  }

  /* impulsion qui parcourt le flux : lente, discrète */
  .eco-pulse {
    stroke: var(--color-lavender-100);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 0.08 1;
    stroke-dashoffset: 1.08;
    opacity: 0.8;
    filter: drop-shadow(0 0 4px var(--color-mauve-300));
    animation: eco-pulse 6.5s cubic-bezier(0.45, 0, 0.2, 1) infinite;
  }

  .eco-pulse.is-late {
    animation-delay: 3.25s;
  }

  @keyframes eco-pulse {
    0% {
      stroke-dashoffset: 0.08;
      opacity: 0;
    }
    10% {
      opacity: 0.8;
    }
    70% {
      opacity: 0.8;
    }
    100% {
      stroke-dashoffset: -1;
      opacity: 0;
    }
  }

  /* ------------------------------------------------------------------ noyau d'identité */
  .eco-core-slot {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 1rem 2rem;
  }

  @media (min-width: 64rem) {
    .eco.is-composed .eco-core-slot {
      padding: 0;
    }
  }

  .eco-core {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(9rem, 22vw, 12.5rem);
    aspect-ratio: 1;
  }

  .eco-core-halo {
    position: absolute;
    inset: -30%;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in oklab, var(--color-electric-500) 34%, transparent),
      color-mix(in oklab, var(--color-mauve-400) 12%, transparent) 55%,
      transparent
    );
    filter: blur(18px);
    opacity: calc(0.9 * var(--glow, 1));
  }

  .eco-core-rings {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    animation: eco-orbit 90s linear infinite;
  }

  @keyframes eco-orbit {
    to {
      transform: rotate(360deg);
    }
  }

  .eco-ring {
    fill: none;
    stroke: var(--color-lavender-100);
    vector-effect: non-scaling-stroke;
  }

  .eco-ring.is-outer {
    stroke-opacity: 0.12;
  }

  .eco-ring.is-dashed {
    stroke-opacity: 0.3;
    stroke-dasharray: 1 7;
    stroke-linecap: round;
  }

  .eco-ring.is-inner {
    stroke: var(--color-mauve-300);
    stroke-opacity: 0.22;
  }

  .eco-node {
    fill: var(--color-lavender-100);
    filter: drop-shadow(0 0 3px var(--color-mauve-300));
  }

  .eco-node.is-faint {
    opacity: 0.45;
  }

  /* monogramme : tuile de verre en losange, initiales droites */
  .eco-core-mark {
    position: relative;
    display: grid;
    place-items: center;
    width: 46%;
    aspect-ratio: 1;
  }

  .eco-core-mark::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 1.1rem;
    transform: rotate(45deg);
    border: 1px solid transparent;
    background:
      linear-gradient(
          145deg,
          color-mix(in oklab, var(--color-navy-800) 92%, transparent),
          color-mix(in oklab, var(--color-ink-950) 96%, transparent)
        )
        padding-box,
      linear-gradient(
          145deg,
          color-mix(in oklab, var(--color-lavender-100) 70%, transparent),
          transparent 45%,
          color-mix(in oklab, var(--color-electric-400) 60%, transparent)
        )
        border-box;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.02) inset,
      0 18px 50px -18px color-mix(in oklab, var(--color-electric-500) 70%, transparent);
  }

  .eco-core-initials {
    position: relative;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.6vw, 1.85rem);
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1;
    background: linear-gradient(
      135deg,
      var(--color-lavender-100),
      var(--color-mauve-300) 55%,
      var(--color-electric-400)
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .eco-core-name {
    margin-top: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-lavender-200);
    text-align: center;
  }

  /* tablette / mobile : un faisceau relie le noyau aux pôles */
  .eco-core-slot::after {
    content: '';
    width: 1px;
    height: 3rem;
    margin-top: 1.25rem;
    background: linear-gradient(var(--color-mauve-300), transparent);
    opacity: 0.6;
  }

  @media (min-width: 64rem) {
    .eco.is-composed .eco-core-slot::after {
      display: none;
    }
  }

  /* ------------------------------------------------------------------ pôles */
  .eco-slot {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .eco-pole {
    --mx: 50%;
    --my: 0%;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    height: 100%;
    padding: clamp(1.75rem, 3.2vw, 2.75rem);
    border-radius: 1.1rem;
    border: 1px solid transparent;
    background:
      linear-gradient(
          160deg,
          color-mix(in oklab, var(--color-navy-900) 88%, transparent),
          color-mix(in oklab, var(--color-ink-950) 94%, transparent)
        )
        padding-box,
      linear-gradient(
          150deg,
          color-mix(in oklab, var(--tone) 55%, transparent),
          rgb(255 255 255 / 0.05) 38%,
          rgb(255 255 255 / 0.03) 62%,
          color-mix(in oklab, var(--tone) 35%, transparent)
        )
        border-box;
    box-shadow:
      0 1px 0 0 rgb(255 255 255 / 0.05) inset,
      0 40px 90px -45px color-mix(in oklab, var(--tone) 55%, transparent);
    transition:
      transform 0.7s var(--ease-out-expo),
      box-shadow 0.7s var(--ease-out-expo);
  }

  @media (min-width: 64rem) {
    .eco.is-composed .eco-pole {
      padding: 2.75rem 2.5rem;
    }
  }

  .eco-pole:hover,
  .eco-pole:focus-within {
    transform: translateY(-4px);
    box-shadow:
      0 1px 0 0 rgb(255 255 255 / 0.08) inset,
      0 50px 110px -45px color-mix(in oklab, var(--tone) 80%, transparent);
  }

  .eco-pole-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  /* texture : réseau technique très discret, fondu vers le bas */
  .eco-pole-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px),
      radial-gradient(
        circle,
        color-mix(in oklab, var(--tone) 60%, transparent) 1px,
        transparent 1.5px
      );
    background-size:
      32px 32px,
      32px 32px,
      32px 32px;
    background-position:
      -1px -1px,
      -1px -1px,
      -1px -1px;
    mask-image: radial-gradient(120% 90% at 85% 0%, black, transparent 72%);
    opacity: 0.8;
  }

  /* lueur qui suit le pointeur (variables --mx / --my posées par motion.ts) */
  .eco-pole-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      420px circle at var(--mx) var(--my),
      color-mix(in oklab, var(--tone) 22%, transparent),
      transparent 65%
    );
    opacity: 0.55;
    transition: opacity 0.6s;
  }

  .eco-pole:hover .eco-pole-glow {
    opacity: 1;
  }

  .eco-pole-head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .eco-pole-index {
    color: var(--tone);
  }

  .eco-pole-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      color-mix(in oklab, var(--tone) 60%, transparent),
      transparent
    );
  }

  .eco-pole-role {
    color: var(--color-paper-muted);
    text-align: right;
  }

  .eco-pole-name {
    margin-top: 2.25rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 7vw, 3.4rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }

  @media (min-width: 64rem) {
    .eco.is-composed .eco-pole-name {
      font-size: clamp(2.2rem, 3.2vw, 3.2rem);
    }
  }

  .eco-pole-text {
    margin-top: 1.25rem;
    max-width: 30rem;
    color: var(--color-paper-muted);
    line-height: 1.7;
  }

  .eco-pole-label {
    margin-top: 2rem;
    margin-bottom: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-paper-faint);
  }

  .eco-domains {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* micro-interaction : la puce s'allume au survol */
  .eco-domain {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.08);
    background: rgb(255 255 255 / 0.025);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.03em;
    color: var(--color-lavender-200);
    transition:
      border-color 0.4s,
      background-color 0.4s,
      color 0.4s,
      transform 0.5s var(--ease-out-expo);
  }

  .eco-domain-dot {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
