---
import { localizedPath, useTranslations } from '@/i18n';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';

const locale = 'fr';
const t = useTranslations(locale);
---

<BaseLayout page="404" locale={locale} title={t.meta.notFoundTitle} noindex>
  <section class="relative grid min-h-[100svh] place-items-center overflow-hidden py-40">
    <div
      class="bg-electric-500/20 pointer-events-none absolute top-1/3 left-1/2 -z-10 size-[44rem] -translate-x-1/2 rounded-full blur-[150px]"
      aria-hidden="true"
    ></div>
    <div class="container-x text-center">
      <p
        class="font-display text-outline text-[clamp(7rem,26vw,22rem)] leading-none font-extrabold tracking-tighter"
        aria-hidden="true"
      >
        404
      </p>
      <h1 class="display-lg -mt-4 md:-mt-10">{t.notFound.title}</h1>
      <p class="text-paper-muted mx-auto mt-6 max-w-md">{t.notFound.text}</p>
      <div class="mt-10 flex justify-center">
        <Button href={localizedPath('/', locale)}>{t.notFound.cta}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
