---
/**
 * Coque de l'administration locale — servie sur /admin UNIQUEMENT en `npm run dev`
 * (route injectée par integrations/local-cms ; absente du site publié).
 * L'interface elle-même est dans src/cms/app/ (TypeScript, sans framework).
 */
import '@/styles/global.css';
import '@/cms/admin.css';
import { domainNumber, domainSlugs } from '@/data/domains';
import { entitySlugs, projectStatuses } from '@/data/entities';
import { useTranslations } from '@/i18n';
import { SPAN_INFO } from '@/lib/gallery-layout';
import fr from '@/i18n/ui/fr';
import { SECTIONS } from '@/lib/studio/layout';
import { siteDefaults } from '@/config/site';
import { getProjects } from '@/lib/projects';

/** Texte d'origine (dictionnaire non modifié) d'un chemin « a.b ». */
const original = (path: string) =>
  path.split('.').reduce<unknown>((node, key) => (node as Record<string, unknown>)?.[key], fr) as
    string | string[];

const t = useTranslations('fr');

// Vocabulaire du site transmis à l'interface (une seule source de vérité : src/data + src/i18n).
// projets (Expertises → Outils : projets associés)
const projects = (await getProjects()).map((p) => ({
  id: p.id,
  title: p.data.title,
  draft: p.data.draft,
}));

const meta = {
  projects,
  categories: domainSlugs.map((slug) => ({
    slug,
    number: domainNumber(slug),
    title: t.domains[slug].title,
  })),
  entities: entitySlugs.map((slug) => ({
    slug,
    name: t.entities[slug].name,
    role: t.entities[slug].role,
  })),
  statuses: projectStatuses.map((slug) => ({ slug, label: t.statuses[slug] })),
  spans: SPAN_INFO,
  studio: {
    texts: Object.fromEntries(
      SECTIONS.flatMap((s) => s.fields).map((field) => [field.path, original(field.path)]),
    ),
    nav: { ...fr.nav },
    dictionary: fr,
    contact: { ...siteDefaults.contact, name: siteDefaults.name },
  },
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <title>Administration — Ibrahima Faye</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="cms">
    <div id="cms-root"></div>
    <script type="application/json" id="cms-meta" set:html={JSON.stringify(meta)}></script>
    <script>
      // Chargement surveillé : si un module de l'interface ne peut pas être chargé (serveur de développement
      // en train de recompiler, par exemple), on recharge UNE fois, puis on affiche un message au lieu d'une page noire.
      const RETRY = 'cms-admin-retry';
      import('@/cms/app/main').then(
        () => sessionStorage.removeItem(RETRY),
        (error) => {
          console.error('[admin] interface non chargée', error);
          if (!sessionStorage.getItem(RETRY)) {
            sessionStorage.setItem(RETRY, '1');
            location.reload();
            return;
          }
          sessionStorage.removeItem(RETRY);
          const root = document.getElementById('cms-root');
          if (root)
            root.innerHTML =
              '<p style="padding:2rem;max-width:40rem;line-height:1.6">L’interface d’administration n’a pas pu se charger. ' +
              'Redémarrez le serveur de développement (<code>npm run dev</code>), puis rechargez cette page.</p>';
        },
      );
    </script>
  </body>
</html>
