---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { defaultLocale, useTranslations, type Locale } from '@/i18n';
import SEO from '@/components/seo/SEO.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { settings } from '@/lib/settings';
import { themeToCss } from '@/lib/studio/theme';

interface Props {
  locale?: Locale;
  /** Identifiant de page : 'home' | 'projects' | 'project' | '404' */
  page: string;
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  path?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { locale = defaultLocale, page, ...seo } = Astro.props;
const t = useTranslations(locale);

// Réglages du Studio (src/settings/) : thème (seulement ce qui est réglé), favicon, animations.
const theme = themeToCss(settings.theme);
const favicon = settings.theme.identity?.favicon || '/favicon.svg';
const nav = settings.navigation;
const navActive = nav.active?.enabled === false ? 'off' : nav.active?.style;
const footerVisible = settings.layout.sections?.footer?.visible !== false;
---

<!doctype html>
<html lang={t.meta.lang} data-page={page} data-nav-active={navActive} {...theme.attrs}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={settings.theme.colors?.bg ?? '#04050d'} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={favicon} type={favicon.endsWith('.svg') ? 'image/svg+xml' : undefined} />
    {theme.css && <style is:inline id="site-theme" set:html={theme.css}></style>}
    <SEO locale={locale} {...seo} />
    <ClientRouter />
    <noscript>
      <style>
        [data-reveal],
        [data-split],
        [data-intro] {
          opacity: 1 !important;
          transform: none !important;
          clip-path: none !important;
        }
      </style>
    </noscript>
  </head>
  <body id="top">
    <a
      href="#main"
      class="bg-electric-500 text-paper focus:not-sr-only sr-only fixed top-3 left-3 z-[100] rounded-full px-5 py-2.5 text-sm font-semibold"
    >
      {t.a11y.skipToContent}
    </a>
    <Header locale={locale} current={page} />
    <main id="main">
      <slot />
    </main>
    {footerVisible && <Footer locale={locale} />}
    <script
      type="application/json"
      id="site-animations"
      set:html={JSON.stringify(settings.animations)}
    ></script>
    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>
