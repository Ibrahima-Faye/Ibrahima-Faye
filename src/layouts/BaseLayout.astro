---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { defaultLocale, useTranslations, type Locale } from '@/i18n';
import SEO from '@/components/seo/SEO.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';

interface Props {
  locale?: Locale;
  /** Identifiant de page : 'home' | 'projects' | 'project' | '404' */
  page: string;
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  path?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { locale = defaultLocale, page, ...seo } = Astro.props;
const t = useTranslations(locale);
---

<!doctype html>
<html lang={t.meta.lang} data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#04050d" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <SEO locale={locale} {...seo} />
    <ClientRouter />
    <noscript>
      <style>
        [data-reveal],
        [data-split],
        [data-intro] {
          opacity: 1 !important;
          transform: none !important;
          clip-path: none !important;
        }
      </style>
    </noscript>
  </head>
  <body id="top">
    <a
      href="#main"
      class="bg-electric-500 text-paper focus:not-sr-only sr-only fixed top-3 left-3 z-[100] rounded-full px-5 py-2.5 text-sm font-semibold"
    >
      {t.a11y.skipToContent}
    </a>
    <Header locale={locale} current={page} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>
